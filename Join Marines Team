-- Chờ game và người chơi tải xong dữ liệu cơ bản
repeat task.wait() until game:IsLoaded() and game.Players.LocalPlayer

local Player = game.Players.LocalPlayer
local MarketplaceService = game:GetService("MarketplaceService")

-- Danh sách ID của cả 3 Sea trong Blox Fruits
local BloxFruits_Seas = {
    [2747447618] = true, -- Sea 1
    [4442272183] = true, -- Sea 2
    [7449423635] = true  -- Sea 3
}

-- Kiểm tra thông tin tên game từ hệ thống Roblox
local success, gameInfo = pcall(function()
    return MarketplaceService:GetProductInfo(game.PlaceId)
end)

-- Nếu đúng là Blox Fruits hoặc thuộc 1 trong 3 Sea
if (success and gameInfo and string.find(gameInfo.Name, "Blox Fruits")) or BloxFruits_Seas[game.PlaceId] then
    
    -- CHỜ ĐÚNG 0.5 GIÂY RỒI MỚI TIẾN HÀNH JOIN PHE
    task.wait(0.5)
    
    -- Vòng lặp liên tục gửi yêu cầu chọn phe
    while task.wait(0.5) do
        -- Kiểm tra nếu đã thuộc phe Marines thành công thì dừng script
        if Player.Team and Player.Team.Name == "Marines" then
            print("Da vao phe Marines thanh cong! Dung script.")
            break
        end
        
        -- Gửi lệnh chọn phe lên Server (Thực hiện liên tục mỗi 0.5 giây nếu chưa vào được)
        local selectTeam = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("CommF_")
        if selectTeam then
            selectTeam:InvokeServer("SetTeam", "Marines")
        end
    end

else
    print("Khong phai Blox Fruits. Script tu dong dung.")
end
