	pickBtn.Text = "Nhấp màn hình..."
	pickBtn.BackgroundColor3 = Color3.fromRGB(230, 150, 0)
end)

UIS.InputBegan:Connect(function(input)
	if not isPicking then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		local p = input.Position

		-- Không cho chọn vào GUI chính
		if p.X >= mainFrame.AbsolutePosition.X
			and p.X <= mainFrame.AbsolutePosition.X + mainFrame.AbsoluteSize.X
			and p.Y >= mainFrame.AbsolutePosition.Y
			and p.Y <= mainFrame.AbsolutePosition.Y + mainFrame.AbsoluteSize.Y then
			return
		end

		createPositionButton(Vector2.new(p.X, p.Y))

		isPicking = false
		pickBtn.Text = "Chọn vị trí"
		pickBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 200)
	end
end)

