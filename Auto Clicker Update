-- 13. PHÍM TẮT
UIS.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end

	if input.KeyCode == TOGGLE_KEY then
		toggleAutoClick()
	elseif input.KeyCode == GUI_KEY then
		toggleGui()
	end
end)

-- 14. AUTO CLICK THEO THỨ TỰ
task.spawn(function()
	local currentIndex = 1

	while controlGui.Parent do
		task.wait(clickDelay)

		if isAutoClicking and #positions > 0 then
			if currentIndex > #positions then
				currentIndex = 1
			end

			local data = positions[currentIndex]
			local button = data and data.button

			if button and button.Parent then
				local absolutePosition = button.AbsolutePosition
				local absoluteSize = button.AbsoluteSize

				local clickX = absolutePosition.X + absoluteSize.X / 2
				local clickY = absolutePosition.Y + absoluteSize.Y / 2

				local oldColor = button.BackgroundColor3
				button.BackgroundColor3 = Color3.fromRGB(50, 255, 50)

				VIM:SendMouseButtonEvent(
					clickX,
					clickY,
					0,
					true,
					game,
					0
				)

				task.wait(0.01)

				VIM:SendMouseButtonEvent(
					clickX,
					clickY,
					0,
					false,
					game,
					0
				)

				task.delay(0.08, function()
					if button and button.Parent then
						button.BackgroundColor3 = oldColor
					end
				end)

				currentIndex += 1
			else
				-- Chỉ xóa khỏi danh sách nếu Button thực sự bị Destroy
				table.remove(positions, currentIndex)
				updateNumbers()

				if currentIndex > #positions then
					currentIndex = 1
				end
			end
		else
			currentIndex = 1
		end
	end
end)
