local function startNoclip()
    if noclipConnection then noclipConnection:Disconnect() end
    noclipConnection = RunService.Stepped:Connect(function()
        Character = LocalPlayer.Character
        if Character then
            for _, part in ipairs(Character:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide == true then
                    part.CanCollide = false
                end
            end
        end
    end)
end

local function stopNoclip()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
    Character = LocalPlayer.Character
    if Character then
        local hrp = Character:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.CanCollide = true end
    end
end

local function smoothFlyTo(targetCFrame)
    Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = Character:FindFirstChild("HumanoidRootPart")
    local humanoid = Character:FindFirstChildWhichIsA("Humanoid")
    if not hrp or not humanoid then return end
    
    startNoclip()
    
    local originalState = humanoid:GetState()
    humanoid:ChangeState(Enum.HumanoidStateType.Physics)
    
    local attachment = Instance.new("Attachment")
    attachment.Parent = hrp
    
    local linearVelocity = Instance.new("LinearVelocity")
    linearVelocity.MaxForce = 99999
    linearVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    linearVelocity.Attachment0 = attachment
    linearVelocity.Parent = hrp
    
    local alignOrientation = Instance.new("AlignOrientation")
    alignOrientation.MaxTorque = 99999
    alignOrientation.Responsiveness = 200
    alignOrientation.Mode = Enum.OrientationMode.OneAttachment
    alignOrientation.Attachment0 = attachment
    alignOrientation.CFrame = targetCFrame
    alignOrientation.Parent = hrp
    
    local speed = 135
    
    while _G.AutoSwordPrompt and (hrp.Position - targetCFrame.Position).Magnitude > 3 do
        local direction = (targetCFrame.Position - hrp.Position).Unit
        linearVelocity.VectorVelocity = direction * speed
        task.wait()
    end
    
    linearVelocity:Destroy()
    alignOrientation:Destroy()
    attachment:Destroy()
    
    hrp.Velocity = Vector3.new(0, 0, 0)
    hrp.CFrame = targetCFrame
    humanoid:ChangeState(originalState)
    
    stopNoclip()
end

local function getAllSwords()
    local swords = {}
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if string.match(desc.Name, "^Fence") then 
            local prompt = desc:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt and prompt.Enabled then
                table.insert(swords, {Object = desc, Prompt = prompt})
            end
        end
    end
    return swords
end

local function startAutoPrompt()
    Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        originalCFrame = hrp.CFrame
    end

    local returnedHome = false

    while _G.AutoSwordPrompt do
        task.wait(0.2)
        
        if game.PlaceId ~= TARGET_PLACE_ID then
            _G.AutoSwordPrompt = false
            ToggleButton.Text = "Auto Prompt: OFF"
            ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
            createNotification("Left designated map! Auto-disabled.")
            break
        end
        
        local availableSwords = getAllSwords()
        
        if #availableSwords == 0 then
            if originalCFrame and not returnedHome then
                StatusLabel.Text = "No Fences left! Returning to origin..."
                smoothFlyTo(originalCFrame)
                returnedHome = true
                StatusLabel.Text = "Returned to original position."
            else
                StatusLabel.Text = "No Fences with prompts found!"
            end
            continue
        end
        
        returnedHome = false
        
        local randomIndex = math.random(1, #availableSwords)
        local targetData = availableSwords[randomIndex]
        local targetSword = targetData.Object
        local prompt = targetData.Prompt
        
        local targetPart = targetSword:IsA("BasePart") and targetSword or targetSword:FindFirstChildWhichIsA("BasePart", true)
        
        if targetPart and prompt and prompt.Enabled then
            StatusLabel.Text = "Flying to: " .. targetSword.Name
            smoothFlyTo(targetPart.CFrame * CFrame.new(0, 3, 0))
            task.wait(0.1)
            
            StatusLabel.Text = "Activating Prompt..."
            if fireproximityprompt then
                fireproximityprompt(prompt, 1)
            else
                prompt:InputHoldBegin()
                task.wait(prompt.HoldDuration + 0.05)
                prompt:InputHoldEnd()
            end
            task.wait(0.2)
        end
    end
    stopNoclip()
end

