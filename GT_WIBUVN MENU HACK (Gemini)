local FeatureElements = {}

local function CreateFeatureRow(key, iconId, isActionOnly)
	local langData = Languages[CurrentLangKey][key]

	local Card = Instance.new("Frame")
	Card.Size = UDim2.new(1, 0, 0, 60)
	Card.BackgroundColor3 = Color3.fromRGB(28, 32, 42)
	Card.BorderSizePixel = 0
	Card.Parent = ScrollingFrame

	local CardCorner = Instance.new("UICorner")
	CardCorner.CornerRadius = UDim.new(0, 8)
	CardCorner.Parent = Card

	local Icon = Instance.new("ImageLabel")
	Icon.Size = UDim2.new(0, 26, 0, 26)
	Icon.Position = UDim2.new(0, 10, 0, 12)
	Icon.BackgroundTransparency = 1
	Icon.Image = iconId
	Icon.ImageColor3 = Color3.fromRGB(0, 200, 255)
	Icon.Parent = Card

	local Title = Instance.new("TextLabel")
	Title.Size = UDim2.new(0.5, 0, 0, 20)
	Title.Position = UDim2.new(0, 44, 0, 8)
	Title.Font = Enum.Font.GothamBold
	Title.Text = langData.Name
	Title.TextColor3 = Color3.fromRGB(240, 240, 240)
	Title.TextSize = 13
	Title.TextXAlignment = Enum.TextXAlignment.Left
	Title.BackgroundTransparency = 1
	Title.Parent = Card

	local Desc = Instance.new("TextLabel")
	Desc.Size = UDim2.new(0.6, 0, 0, 24)
	Desc.Position = UDim2.new(0, 44, 0, 28)
	Desc.Font = Enum.Font.Gotham
	Desc.Text = langData.Desc
	Desc.TextColor3 = Color3.fromRGB(150, 150, 160)
	Desc.TextSize = 10
	Desc.TextXAlignment = Enum.TextXAlignment.Left
	Desc.TextWrapped = true
	Desc.BackgroundTransparency = 1
	Desc.Parent = Card

	FeatureElements[key] = {Title = Title, Desc = Desc}

	if isActionOnly then
		local ActionBtn = Instance.new("TextButton")
		ActionBtn.Size = UDim2.new(0, 70, 0, 28)
		ActionBtn.Position = UDim2.new(1, -80, 0, 16)
		ActionBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 220)
		ActionBtn.Font = Enum.Font.GothamBold
		ActionBtn.Text = "RUN"
		ActionBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		ActionBtn.TextSize = 11
		ActionBtn.Parent = Card

		local ActionCorner = Instance.new("UICorner")
		ActionCorner.CornerRadius = UDim.new(0, 6)
		ActionCorner.Parent = ActionBtn

		ActionBtn.MouseButton1Click:Connect(function()
			if key == "FixLag" then ToggleFixLag() end
			ActionBtn.Text = "DONE!"
			task.wait(1)
			ActionBtn.Text = "RUN"
		end)
	else
		local ToggleBtn = Instance.new("TextButton")
		ToggleBtn.Size = UDim2.new(0, 65, 0, 28)
		ToggleBtn.Position = UDim2.new(1, -75, 0, 16)
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
		ToggleBtn.Font = Enum.Font.GothamBold
		ToggleBtn.Text = "OFF"
		ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		ToggleBtn.TextSize = 11
		ToggleBtn.Parent = Card

		local ToggleCorner = Instance.new("UICorner")
		ToggleCorner.CornerRadius = UDim.new(0, 6)
		ToggleCorner.Parent = ToggleBtn

		local SliderFrame = nil
		local SliderLabel = nil

		if key == "SpeedBoost" or key == "JumpBoost" then
			SliderFrame = Instance.new("Frame")
			SliderFrame.Size = UDim2.new(1, -20, 0, 35)
			SliderFrame.Position = UDim2.new(0, 10, 0, 58)
			SliderFrame.BackgroundTransparency = 1
			SliderFrame.Visible = false
			SliderFrame.Parent = Card

			SliderLabel = Instance.new("TextLabel")
			SliderLabel.Size = UDim2.new(1, 0, 0, 15)
			SliderLabel.Font = Enum.Font.GothamMedium
			SliderLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
			SliderLabel.TextSize = 10
			SliderLabel.TextXAlignment = Enum.TextXAlignment.Left
			SliderLabel.BackgroundTransparency = 1
			SliderLabel.Parent = SliderFrame

			local SliderBar = Instance.new("Frame")
			SliderBar.Size = UDim2.new(1, 0, 0, 8)
			SliderBar.Position = UDim2.new(0, 0, 0, 20)
			SliderBar.BackgroundColor3 = Color3.fromRGB(45, 50, 65)
			SliderBar.BorderSizePixel = 0
			SliderBar.Parent = SliderFrame

			local SliderFill = Instance.new("Frame")
			SliderFill.Size = UDim2.new(0.3, 0, 1, 0)
			SliderFill.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
			SliderFill.BorderSizePixel = 0
			SliderFill.Parent = SliderBar

			local function UpdateSlider(input)
				local pos = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
				SliderFill.Size = UDim2.new(pos, 0, 1, 0)

				if key == "SpeedBoost" then
					Config.SpeedMultiplier = math.floor(16 + (pos * 184))
					SliderLabel.Text = Languages[CurrentLangKey].SpeedValue .. tostring(Config.SpeedMultiplier)
				elseif key == "JumpBoost" then
					Config.JumpMultiplier = math.floor(50 + (pos * 250))
					SliderLabel.Text = Languages[CurrentLangKey].JumpValue .. tostring(Config.JumpMultiplier)
				end
			end

			local isDragging = false
			SliderBar.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					isDragging = true
					UpdateSlider(input)
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					isDragging = false
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					UpdateSlider(input)
				end
			end)

			if key == "SpeedBoost" then
				SliderLabel.Text = Languages[CurrentLangKey].SpeedValue .. tostring(Config.SpeedMultiplier)
			else
				SliderLabel.Text = Languages[CurrentLangKey].JumpValue .. tostring(Config.JumpMultiplier)
			end
			FeatureElements[key].SliderLabel = SliderLabel
		end

		ToggleBtn.MouseButton1Click:Connect(function()
			FeatureStates[key] = not FeatureStates[key]
			local state = FeatureStates[key]

			if state then
				ToggleBtn.Text = "ON"
				ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 70)
				if SliderFrame then
					Card.Size = UDim2.new(1, 0, 0, 100)
					SliderFrame.Visible = true
				end
				if key == "Fly" then StartFly() end
				if key == "FlyCam" then StartFlyCam() end
			else
				ToggleBtn.Text = "OFF"
				ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
				if SliderFrame then
					Card.Size = UDim2.new(1, 0, 0, 60)
					SliderFrame.Visible = false
				end
				if key == "Fly" then StopFly() end
				if key == "FlyCam" then StopFlyCam() end
				if key == "SpeedBoost" and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
					LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = 16
				end
				if key == "JumpBoost" and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
					LocalPlayer.Character:FindFirstChildOfClass("Humanoid").JumpPower = 50
				end
			end
		end)
	end
end

