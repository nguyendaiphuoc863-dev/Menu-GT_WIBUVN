local function SetAutoPerfectState(State)
	AutoEnabled = State
	AutoPerfectButton.Text = State and "ON" or "OFF"

	if not State then
		LastY = nil
		PreviousMarkerTop = nil
		WasAboveTop = false
	end

	Tween(AutoPerfectButton, SmoothTween, {
		BackgroundColor3 = State and Color3.fromRGB(45, 155, 90) or Color3.fromRGB(180, 55, 65)
	})

	Tween(ToggleStroke, SmoothTween, {
		Color = State and Color3.fromRGB(100, 230, 145) or Color3.fromRGB(230, 100, 110)
	})
end

AutoPerfectButton.MouseButton1Click:Connect(function()
	if IsClosing then return end

	if not AutoEnabled and IsTrainingSequenceEnabled() then
		Notify("You cannot enable Auto Perfect while Training is active!")
		return
	end

	if not AutoEnabled and (AutoThrowEnabled or AutoTrainingEnabled) then
		Notify("Please turn off Auto Throw and Auto Training before enabling Auto Perfect!")
		return
	end

	AutoEnabled = not AutoEnabled

	if AutoEnabled then
		AutoPerfectButton.Text = "ON"
		Tween(AutoPerfectButton, SmoothTween, {BackgroundColor3 = Color3.fromRGB(45, 155, 90)})
		Tween(ToggleStroke, SmoothTween, {Color = Color3.fromRGB(100, 230, 145)})
		Notify("Auto Perfect has been enabled!")
	else
		AutoPerfectButton.Text = "OFF"
		LastY = nil
		Tween(AutoPerfectButton, SmoothTween, {BackgroundColor3 = Color3.fromRGB(180, 55, 65)})
		Tween(ToggleStroke, SmoothTween, {Color = Color3.fromRGB(230, 100, 110)})
		Notify("Auto Perfect has been disabled!")
	end
end)

