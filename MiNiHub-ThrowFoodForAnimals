local CoreGuiLost = false

local function StopAllFeatures()
	if CoreGuiLost then return end
	CoreGuiLost = true

	AutoEnabled = false
	AutoThrowToken += 1
	AutoTrainingEnabled = false
	AutoTrainingToken += 1
	SetAutoThrowState(false)

	AutoPerfectButton.Text = "OFF"
	LastY = nil

	Tween(AutoPerfectButton, SmoothTween, {
		BackgroundColor3 = Color3.fromRGB(180, 55, 65)
	})

	Tween(ToggleStroke, SmoothTween, {
		Color = Color3.fromRGB(230, 100, 110)
	})

	if RenderConnection then
		RenderConnection:Disconnect()
		RenderConnection = nil
	end
end

ScreenGui.AncestryChanged:Connect(function()
	if not ScreenGui:IsDescendantOf(CoreGui) and not ScreenGui:IsDescendantOf(PlayerGui) then
		StopAllFeatures()
	end
end)

task.spawn(function()
	if not ScreenGui.Parent then return end

	for Progress = 1, 100 do
		if not ScreenGui.Parent then return end

		LoadingPercent.Text = Progress .. "%"
		LoadingStatus.Text = Progress < 100 and "Loading components..." or "Loading complete!"

		Tween(LoadingFill, TweenInfo.new(0.01, Enum.EasingStyle.Linear), {
			Size = UDim2.new(Progress / 100, 0, 1, 0)
		})

		task.wait(0.035)
	end

	task.wait(0.3)
	if not ScreenGui.Parent then return end

	Tween(LoadingFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		GroupTransparency = 1
	}).Completed:Wait()

	if not ScreenGui.Parent then return end

	CoreGuiLoading:Destroy()

	MainFrame.Visible = true
	MainScale.Scale = 0.82
	MainFrame.GroupTransparency = 1

	Tween(MainScale, TweenInfo.new(0.65, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1})
	Tween(MainFrame, TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {GroupTransparency = 0})
end)
