local function ClickScreen()
	if IsClosing or (not AutoEnabled and not AutoThrowEnabled) then return end

	local Camera = workspace.CurrentCamera
	if not Camera then return end

	local ViewportSize = Camera.ViewportSize
	local CenterX = ViewportSize.X / 2
	local CenterY = ViewportSize.Y / 2

	VirtualInputManager:SendMouseButtonEvent(CenterX, CenterY, 0, true, game, 1)
	task.wait(0.03)
	VirtualInputManager:SendMouseButtonEvent(CenterX, CenterY, 0, false, game, 1)
end

AutoThrowButton.MouseButton1Click:Connect(function()
	if IsClosing then return end

	if not AutoThrowEnabled and IsTrainingSequenceEnabled() then
		Notify("You cannot enable Auto Throw while Training is active!")
		return
	end

	if not AutoThrowEnabled and (AutoEnabled or AutoTrainingEnabled) then
		Notify("Please turn off Auto Perfect and Auto Training before enabling Auto Throw!")
		return
	end

	if AutoThrowEnabled then
		AutoThrowToken += 1
		SetAutoThrowState(false)
		Notify("Auto Throw has been disabled!")
		return
	end

	AutoThrowToken += 1
	local Token = AutoThrowToken
	SetAutoThrowState(true)
	Notify("Auto Throw has been enabled!")

	task.spawn(function()
		local LastClick = 0

		while AutoThrowEnabled and AutoThrowToken == Token and not IsClosing do
			local ThrowSequence = PlayerGui:FindFirstChild("ThrowSequence")

			if ThrowSequence and ThrowSequence.Enabled then
				if tick() - LastClick >= 0.5 then
					local HasVisibleLabel = false

					for _, Object in ipairs(ThrowSequence:GetChildren()) do
						if Object:IsA("TextLabel") and Object.Visible and Object.AbsoluteSize.X > 0 and Object.AbsoluteSize.Y > 0 then
							HasVisibleLabel = true
							break
						end
					end

					if HasVisibleLabel and AutoThrowEnabled and AutoThrowToken == Token then
						ClickScreen()
						LastClick = tick()
					end
				end

				task.wait(0.05)
			else
				LastClick = 0
				TeleportToStarterArea()
				task.wait(0.5)
			end
		end
	end)
end)

local RenderConnection
local PreviousMarkerTop = nil
local WasAboveTop = false

RenderConnection = RunService.RenderStepped:Connect(function()
	if (not AutoEnabled and not AutoThrowEnabled) or IsClosing then
		PreviousMarkerTop = nil
		WasAboveTop = false
		return
	end

	local ThrowSequence = PlayerGui:FindFirstChild("ThrowSequence")
	if not ThrowSequence or not ThrowSequence.Enabled then
		PreviousMarkerTop = nil
		WasAboveTop = false
		return
	end

	local Meter = ThrowSequence:FindFirstChild("Meter")
	local Bar = Meter and Meter:FindFirstChild("Bar")
	local Marker = Bar and Bar:FindFirstChild("Marker")
	local Stripes = Bar and Bar:FindFirstChild("Stripes")

	if not Marker or not Marker:IsA("GuiObject") or not Marker.Visible or not Stripes or not Stripes:IsA("GuiObject") or not Stripes.Visible then
		PreviousMarkerTop = nil
		WasAboveTop = false
		return
	end

	local MarkerTop = Marker.AbsolutePosition.Y
	local MarkerBottom = MarkerTop + Marker.AbsoluteSize.Y
	local StripesTop = Stripes.AbsolutePosition.Y

	if Marker.AbsoluteSize.Y <= 0 or Stripes.AbsoluteSize.Y <= 0 then
		PreviousMarkerTop = nil
		WasAboveTop = false
		return
	end

	local IsMovingUp = PreviousMarkerTop ~= nil and MarkerTop < PreviousMarkerTop
	local HasReachedTop = PreviousMarkerTop ~= nil
		and PreviousMarkerTop > StripesTop
		and MarkerTop <= StripesTop
		and MarkerBottom >= StripesTop

	if IsMovingUp and HasReachedTop and not WasAboveTop and tick() - LastClickTime >= 0.2 then
		WasAboveTop = true
		LastClickTime = tick()

		task.spawn(function()
			if not IsClosing and (AutoEnabled or AutoThrowEnabled) then
				ClickScreen()
			end
		end)
	end

	if MarkerTop > StripesTop then
		WasAboveTop = false
	end

	PreviousMarkerTop = MarkerTop
end)

