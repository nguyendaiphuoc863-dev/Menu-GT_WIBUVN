local function RemoveOldGui()
	for _, container in ipairs({CoreGui, PlayerGui}) do
		pcall(function()
			for _, gui in ipairs(container:GetChildren()) do
				if gui:IsA("ScreenGui") and gui.Name == GUI_NAME then
					gui:Destroy()
				end
			end
		end)
	end
end
