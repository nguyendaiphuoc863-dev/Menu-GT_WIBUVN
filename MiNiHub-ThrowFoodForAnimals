local function UpdateResponsiveSize()
	local Camera = workspace.CurrentCamera
	if not Camera then return end

	local Viewport = Camera.ViewportSize
	local AvailableWidth = math.max(200, Viewport.X - ScreenPadding * 2)
	local AvailableHeight = math.max(150, Viewport.Y - ScreenPadding * 2)

	local TargetSize = NormalSize
	local ScaleX = AvailableWidth / NormalSize.X.Offset
	local ScaleY = AvailableHeight / NormalSize.Y.Offset
	local ResponsiveScale = math.min(ScaleX, ScaleY, 1)

	MainScale.Scale = ResponsiveScale

	if Minimized then
		MainFrame.Size = MinimizedSize
	else
		MainFrame.Size = NormalSize
	end
end

UpdateResponsiveSize()

if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateResponsiveSize)
end

