-- 12. KÉO GUI PC + MOBILE
local dragStart
local startPos
local dragInput

mainFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragStart = input.Position
		startPos = mainFrame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragStart = nil
				dragInput = nil
			end
		end)
	end
end)

mainFrame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

		dragInput = input
	end
end)

UIS.InputChanged:Connect(function(input)
	if input == dragInput and dragStart then
		local delta = input.Position - dragStart

		mainFrame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

-- 13. CẬP NHẬT SỐ
local function updateNumbers()
	for i, data in ipairs(positions) do
		if data.button and data.button.Parent then
			data.button.Text = tostring(i)
		end
	end
end

-- 14. XÓA MỘT VỊ TRÍ
local function removePosition(index)
	if not positions[index] then
		return
	end

	local data = positions[index]

	if data.button then
		data.button:Destroy()
	end

	table.remove(positions, index)
	updateNumbers()
end

-- 15. TẠO TEXTBUTTON
local function createPositionButton(pos)
	local index = #positions + 1

	local button = Instance.new("TextButton")
	button.Size = UDim2.new(0, 45, 0, 45)

	-- Đặt tâm TextButton đúng vào vị trí người dùng chạm/click
	button.Position = UDim2.new(
		0,
		pos.X - 22.5,
		0,
		pos.Y - 22.5
	)

	button.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
	button.BackgroundTransparency = 0.1
	button.Text = tostring(index)
	button.TextScaled = true
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	button.Font = Enum.Font.SourceSansBold
	button.ZIndex = 20
	button.AutoButtonColor = true
	button.Active = true
	button.Parent = controlGui

	Instance.new("UICorner", button).CornerRadius = UDim.new(1, 0)

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Parent = button

	local data = {
		button = button
	}

	table.insert(positions, data)

	-- Click/Tap vào TextButton = xóa nó
	button.Activated:Connect(function()
		for i, item in ipairs(positions) do
			if item == data then
				removePosition(i)
				break
			end
		end
	end)
end

-- 16. CHỌN VỊ TRÍ PC + MOBILE
pickBtn.Activated:Connect(function()
	isPicking = true

	pickBtn.Text = "Nhấp màn hình..."
	pickBtn.BackgroundColor3 = Color3.fromRGB(230, 150, 0)
end)

UIS.InputBegan:Connect(function(input, processed)
	if not isPicking then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	local p = input.Position

	-- Không chọn vào GUI chính
	local mainPos = mainFrame.AbsolutePosition
	local mainSize = mainFrame.AbsoluteSize

	if p.X >= mainPos.X
		and p.X <= mainPos.X + mainSize.X
		and p.Y >= mainPos.Y
		and p.Y <= mainPos.Y + mainSize.Y then

		return
	end

	-- Không tạo vị trí mới khi chạm vào nút restore
	if restoreBtn.Visible then
		local restorePos = restoreBtn.AbsolutePosition
		local restoreSize = restoreBtn.AbsoluteSize

		if p.X >= restorePos.X
			and p.X <= restorePos.X + restoreSize.X
			and p.Y >= restorePos.Y
			and p.Y <= restorePos.Y + restoreSize.Y then

			return
		end
	end

	-- Không tạo marker chồng lên marker cũ
	local guiObjects = GuiService:GetGuiObjectsAtPosition(p.X, p.Y)

	for _, guiObject in ipairs(guiObjects) do
		for _, data in ipairs(positions) do
			if guiObject == data.button then
				return
			end
		end
	end

	createPositionButton(Vector2.new(p.X, p.Y))

	isPicking = false
	pickBtn.Text = "Chọn vị trí"
	pickBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 200)
end)

