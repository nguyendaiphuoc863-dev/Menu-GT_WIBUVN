-- 19. BẬT/TẮT AUTO CLICK
local function toggleAutoClick()
	if isToggling then
		return
	end

	if #positions == 0 then
		isToggling = true

		local oldText = toggleBtn.Text
		local oldColor = toggleBtn.BackgroundColor3

		toggleBtn.Text = "Chưa có vị trí!"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(230, 120, 0)

		task.wait(0.8)

		toggleBtn.Text = oldText
		toggleBtn.BackgroundColor3 = oldColor

		isToggling = false

		return
	end

	isAutoClicking = not isAutoClicking

	if isAutoClicking then
		toggleBtn.Text = "Auto Click: ON [H]"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
	else
		toggleBtn.Text = "Auto Click: OFF [H]"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
	end
end

toggleBtn.Activated:Connect(toggleAutoClick)

-- 20. ẨN / HIỆN GUI
local function toggleGui()
	mainFrame.Visible = not mainFrame.Visible
	restoreBtn.Visible = not mainFrame.Visible

	-- Chỉ ẩn/hiện, KHÔNG xóa positions
	for _, data in ipairs(positions) do
		if data.button and data.button.Parent then
			data.button.Visible = mainFrame.Visible
		end
	end
end

miniBtn.Activated:Connect(toggleGui)
restoreBtn.Activated:Connect(toggleGui)

