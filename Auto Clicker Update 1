local function createText(class, parent, size, pos, txt, font, bold)
	local obj = Instance.new(class)
	obj.Size = size
	obj.Position = pos
	obj.Text = txt
	obj.Font = font
	obj.TextColor3 = Color3.fromRGB(255, 255, 255)
	obj.TextScaled = true
	obj.BackgroundTransparency = 1
	obj.Parent = parent

	if bold then
		obj.Font = Enum.Font.SourceSansBold
	end

	return obj
end

