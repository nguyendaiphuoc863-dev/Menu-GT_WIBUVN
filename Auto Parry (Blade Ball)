-- =======================================================
-- LOGIC KÉO SIÊU MƯỢT CHO CẢ MOBILE (TOUCH) VÀ PC (MOUSE)
-- =======================================================
local Dragging = false
local DragStart = Vector3.new()
local StartPos = UDim2.new()

-- Sự kiện nhấn xuống trên TitleBar (Hỗ trợ chuột trái PC và chạm tay Mobile)
TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        Dragging = true
        DragStart = input.Position
        StartPos = MainFrame.Position
        
        -- Ngắt trạng thái kéo khi buông tay/thả chuột ngoài vùng
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                Dragging = false
            end
        end)
    end
end)

-- Lắng nghe di chuyển toàn hệ thống để cập nhật vị trí Frame mượt mà
UserInputService.InputChanged:Connect(function(input)
    if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local Delta = input.Position - DragStart
        MainFrame.Position = UDim2.new(
            StartPos.X.Scale, 
            StartPos.X.Offset + Delta.X, 
            StartPos.Y.Scale, 
            StartPos.Y.Offset + Delta.Y
        )
    end
end)

-- =======================================================
-- LOGIC BẬT/TẮT VÀ CẬP NHẬT GIAO DIỆN
-- =======================================================
local function ToggleAutoParry()
    autoParryEnabled = not autoParryEnabled
    if autoParryEnabled then
        MainStroke.Color = Color3.fromRGB(60, 255, 60)
        ButtonText.Text = "STATUS: ACTIVE" 
        ButtonGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(40, 240, 40)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 150, 20))
        })
        SendNotification("Auto Parry", "Trạng thái: ĐÃ BẬT 🟢", 1.5)
    else
        MainStroke.Color = Color3.fromRGB(255, 60, 60)
        ButtonText.Text = "STATUS: OFF" 
        ButtonGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(240, 40, 40)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 20, 20))
        })
        SendNotification("Auto Parry", "Trạng thái: ĐÃ TẮT 🔴", 1.5)
    end
end

-- Dùng Activated để Mobile nhận diện nhấn thả chuẩn xác, không bị nhầm khi đang kéo
ToggleButton.Activated:Connect(ToggleAutoParry)

-- Giữ phím tắt K cho PC
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.K then
        ToggleAutoParry()
    end
end)

-- =======================================================
-- VÒNG LẶP KIỂM TRA ĐỠ BÓNG
-- =======================================================
local function MonitorBall()
    local Ball = GetBall()
    if not Ball then return end
    ResetConnection()
    Connection = Ball:GetAttributeChangedSignal("target"):Connect(function()
        local currentTarget = Ball:GetAttribute("target")
        if currentTarget ~= Player.Name then
            IsParried = false
        end
    end)
end

if workspace:FindFirstChild("Balls") then
    workspace.Balls.ChildAdded:Connect(MonitorBall)
end
task.spawn(MonitorBall)

RunService.PreSimulation:Connect(function()
    if not autoParryEnabled then return end
    
    local Ball = GetBall()
    local Character = Player.Character
    local HRP = Character and Character:FindFirstChild("HumanoidRootPart")
    
    if not Ball or not HRP or not Ball:FindFirstChild("zoomies") then return end
    
    local BallVelocity = Ball.zoomies.VectorVelocity
    local Speed = BallVelocity.Magnitude
    if Speed <= 0 then Speed = 0.1 end
    
    local Distance = (HRP.Position - Ball.Position).Magnitude
    local Target = Ball:GetAttribute("target")
    local TimeToHit = Distance / Speed
    
    if Target == Player.Name and not IsParried and TimeToHit <= 0.55 then
        IsParried = true
        TriggerParry()
        
        task.delay(0.3, function()
            IsParried = false
        end)
    end
end)
