-- Logic xử lý Auto Click
local autoClickActive = false
local clickDelay = 0.01 -- Tốc độ click (0.01 giây/lần). Bạn có thể chỉnh sửa số này.

-- Hàm thực hiện hành động Bật / Tắt
local function toggleAutoClick()
    autoClickActive = not autoClickActive
    
    if autoClickActive then
        toggleButton.Text = "Auto Click: ON"
        toggleButton.BackgroundColor3 = Color3.fromRGB(255, 75, 75) -- Đổi sang màu đỏ khi đang bật
        
        -- Chạy vòng lặp click ngầm (Thực hiện click chuột trái)
        task.spawn(function()
            while autoClickActive do
                -- Giả lập click chuột trái bằng VirtualUser (An toàn và không bị dính chuột)
                VirtualUser:CaptureController()
                VirtualUser:ClickButton1(Vector2.new(0, 0))
                
                task.wait(clickDelay)
            end
        end)
    else
        toggleButton.Text = "Auto Click: OFF"
        toggleButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255) -- Trả về màu xanh khi tắt
    end
end

-- 1. Sự kiện khi Click trực tiếp vào nút trên GUI
toggleButton.MouseButton1Click:Connect(function()
    toggleAutoClick()
end)

-- 2. Sự kiện khi nhấn phím P trên bàn phím
UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
    -- Nếu đang gõ chat hoặc đang tương tác với UI hệ thống thì bỏ qua phím P
    if gameProcessedEvent then return end
    
    if input.KeyCode == Enum.KeyCode.P then
        toggleAutoClick()
    end
end)

-- Tự động ngăn game kick người chơi vì treo máy (Anti-AFK)
