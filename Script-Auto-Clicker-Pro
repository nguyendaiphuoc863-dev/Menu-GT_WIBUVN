delBtn.MouseButton1Click:Connect(function()
    clearMarker()

    if isAutoClicking then
        isAutoClicking = false
        toggleBtn.Text = "Auto Click: OFF [H]"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

UIS.InputBegan:Connect(function(input)
    if not isPicking then
        return
    end

    local validInput =
        input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch

    if not validInput then
        return
    end

    local position = input.Position

    if isInsideMainFrame(position) then
        return
    end

    createMarker(position)

    isPicking = false
    pickBtn.Text = "Select Position"
    pickBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 200)
end)

delayBox.FocusLost:Connect(function()
    clickDelay = tonumber(delayBox.Text) or clickDelay

    if clickDelay < 0.01 then
        clickDelay = 0.01
    end

    delayBox.Text = tostring(clickDelay)
end)

local function toggleAutoClick()
    if isToggling then
        return
    end

    if not markerLabel or not targetPos then
        isToggling = true

        local oldColor = toggleBtn.BackgroundColor3
        local oldText = toggleBtn.Text

        toggleBtn.Text = "Position Not Set!"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(230, 120, 0)

        task.wait(0.8)

        toggleBtn.Text = isAutoClicking and "Auto Click: ON [H]" or "Auto Click: OFF [H]"
        toggleBtn.BackgroundColor3 = oldColor
        isToggling = false

        return
    end

    isAutoClicking = not isAutoClicking

    if isAutoClicking then
        toggleBtn.Text = "Auto Click: ON [H]"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    else
        toggleBtn.Text = "Auto Click: OFF [H]"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end

toggleBtn.MouseButton1Click:Connect(toggleAutoClick)

local function toggleGui()
    mainFrame.Visible = not mainFrame.Visible
    restoreBtn.Visible = not mainFrame.Visible

    if markerLabel then
        markerLabel.Visible = mainFrame.Visible
    end
end

miniBtn.MouseButton1Click:Connect(toggleGui)
restoreBtn.MouseButton1Click:Connect(toggleGui)

closeBtn.MouseButton1Click:Connect(function()
    controlGui:Destroy()
    script:Destroy()
end)

UIS.InputBegan:Connect(function(input, processed)
    if processed then
        return
    end

    if input.KeyCode == TOGGLE_KEY then
        toggleAutoClick()
    elseif input.KeyCode == GUI_KEY then
        toggleGui()
    end
end)

task.spawn(function()
    while true do
        task.wait(clickDelay)

        if isAutoClicking and targetPos and markerLabel then
            VIM:SendMouseButtonEvent(
                targetPos.X,
                targetPos.Y,
                0,
                true,
                game,
                0
            )

            task.wait(0.01)

            VIM:SendMouseButtonEvent(
                targetPos.X,
                targetPos.Y,
                0,
                false,
                game,
                0
            )
        end
    end
end)
