local Players, UIS, VIM = game:GetService("Players"), game:GetService("UserInputService"), game:GetService("VirtualInputManager")
local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

local TOGGLE_KEY, GUI_KEY = Enum.KeyCode.H, Enum.KeyCode.K
local clickDelay, targetPos, markerLabel, isAutoClicking, isToggling = 0.5, nil, nil, false, false

-- 1. DỌN SẠCH BẢN CŨ
if playerGui:FindFirstChild("CustomAutoClickerGui") then playerGui.CustomAutoClickerGui:Destroy() end

-- 2. TẠO GIAO DIỆN KHUNG CHÍNH
local controlGui = Instance.new("ScreenGui", playerGui) controlGui.Name = "CustomAutoClickerGui" controlGui.ResetOnSpawn = false
local mainFrame = Instance.new("Frame", controlGui) mainFrame.Size = UDim2.new(0, 200, 0, 180) mainFrame.Position = UDim2.new(0.1, 0, 0.2, 0) mainFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 40) mainFrame.Active = true
Instance.new("UICorner", mainFrame).CornerRadius = UDim.new(0, 8)

-- Hàm tạo Text nhanh + Bật Scaled tự động co giãn chữ
local function createText(class, parent, size, pos, txt, font, bold)
	local obj = Instance.new(class, parent) obj.Size, obj.Position, obj.Text, obj.Font = size, pos, txt, font
	obj.TextColor3, obj.TextScaled, obj.BackgroundTransparency = Color3.fromRGB(255, 255, 255), true, 1
	if bold then obj.Font = Enum.Font.SourceSansBold end return obj
end

local title = createText("TextLabel", mainFrame, UDim2.new(1, -55, 0, 30), UDim2.new(0, 10, 0, 0), "Clicker Custom Pro", Enum.Font.SourceSans, true) title.TextXAlignment = Enum.TextXAlignment.Left

-- Nút X (Xóa sạch) & Nút - (Ẩn tạm)
local closeBtn = Instance.new("TextButton", mainFrame) closeBtn.Size, closeBtn.Position, closeBtn.BackgroundColor3, closeBtn.Text, closeBtn.TextScaled, closeBtn.TextColor3, closeBtn.Font = UDim2.new(0, 20, 0, 20), UDim2.new(1, -25, 0, 5), Color3.fromRGB(200, 50, 50), "X", true, Color3.fromRGB(255, 255, 255), Enum.Font.SourceSansBold Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 4)
local miniBtn = Instance.new("TextButton", mainFrame) miniBtn.Size, miniBtn.Position, miniBtn.BackgroundColor3, miniBtn.Text, miniBtn.TextScaled, miniBtn.TextColor3, miniBtn.Font = UDim2.new(0, 20, 0, 20), UDim2.new(1, -50, 0, 5), Color3.fromRGB(220, 130, 20), "-", true, Color3.fromRGB(255, 255, 255), Enum.Font.SourceSansBold Instance.new("UICorner", miniBtn).CornerRadius = UDim.new(0, 4)

-- Nút Hiện lại nhanh
local restoreBtn = Instance.new("TextButton", controlGui) restoreBtn.Size, restoreBtn.Position, restoreBtn.BackgroundColor3, restoreBtn.Text, restoreBtn.TextScaled, restoreBtn.TextColor3, restoreBtn.Font, restoreBtn.Visible = UDim2.new(0, 90, 0, 30), UDim2.new(0, 10, 0, 10), Color3.fromRGB(0, 150, 100), "Hiện GUI [K]", true, Color3.fromRGB(255, 255, 255), Enum.Font.SourceSansBold, false Instance.new("UICorner", restoreBtn).CornerRadius = UDim.new(0, 6)

-- Các nút tính năng bên trong
local pickBtn = Instance.new("TextButton", mainFrame) pickBtn.Size, pickBtn.Position, pickBtn.BackgroundColor3, pickBtn.Text, pickBtn.TextScaled, pickBtn.TextColor3, pickBtn.Font = UDim2.new(0, 115, 0, 30), UDim2.new(0, 10, 0, 35), Color3.fromRGB(0, 120, 200), "Chọn vị trí", true, Color3.fromRGB(255, 255, 255), Enum.Font.SourceSansBold Instance.new("UICorner", pickBtn).CornerRadius = UDim.new(0, 6)
local delBtn = Instance.new("TextButton", mainFrame) delBtn.Size, delBtn.Position, delBtn.BackgroundColor3, delBtn.Text, delBtn.TextScaled, delBtn.TextColor3, delBtn.Font = UDim2.new(0, 55, 0, 30), UDim2.new(0, 135, 0, 35), Color3.fromRGB(120, 120, 120), "Xóa", true, Color3.fromRGB(255, 255, 255), Enum.Font.SourceSansBold Instance.new("UICorner", delBtn).CornerRadius = UDim.new(0, 6)

-- TextBox Delay
local delayFrame = Instance.new("Frame", mainFrame) delayFrame.Size, delayFrame.Position, delayFrame.BackgroundTransparency = UDim2.new(1, -20, 0, 30), UDim2.new(0, 10, 0, 75), 1
local delayHint = createText("TextLabel", delayFrame, UDim2.new(0, 90, 1, 0), UDim2.new(0, 0, 0, 0), "Delay (giây):", Enum.Font.SourceSans, false) delayHint.TextColor3, delayHint.TextXAlignment = Color3.fromRGB(200, 200, 200), Enum.TextXAlignment.Left
local delayBox = Instance.new("TextBox", delayFrame) delayBox.Size, delayBox.Position, delayBox.BackgroundColor3, delayBox.Text, delayBox.TextScaled, delayBox.TextColor3, delayBox.Font, delayBox.ClearTextOnFocus = UDim2.new(0, 85, 1, 0), UDim2.new(0, 95, 0, 0), Color3.fromRGB(25, 25, 25), "0.5", true, Color3.fromRGB(50, 255, 50), Enum.Font.SourceSansBold, false Instance.new("UICorner", delayBox).CornerRadius = UDim.new(0, 4)

-- Nút Bật/Tắt chính
local toggleBtn = Instance.new("TextButton", mainFrame) toggleBtn.Size, toggleBtn.Position, toggleBtn.BackgroundColor3, toggleBtn.Text, toggleBtn.TextScaled, toggleBtn.TextColor3, toggleBtn.Font = UDim2.new(1, -20, 0, 40), UDim2.new(0, 10, 0, 120), Color3.fromRGB(200, 50, 50), "Auto Click: OFF [H]", true, Color3.fromRGB(255, 255, 255), Enum.Font.SourceSansBold Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 6)

-- 3. KÉO THẢ DI CHUYỂN
local dragStart, startPos, dragInput
mainFrame.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragStart, startPos = i.Position, mainFrame.Position i.Changed:Connect(function() if i.UserInputState == Enum.UserInputState.End then dragStart = nil end end) end end)
mainFrame.InputChanged:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseMovement then dragInput = i end end)
UIS.InputChanged:Connect(function(i) if i == dragInput and dragStart then local d = i.Position - dragStart mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y) end end)

-- 4. CHỌN VÀ XÓA TỌA ĐỘ VỊ TRÍ
pickBtn.MouseButton1Click:Connect(function() isPicking = true pickBtn.Text, pickBtn.BackgroundColor3 = "Nhấp màn hình...", Color3.fromRGB(230, 150, 0) end)
local function clearMarker() if markerLabel then markerLabel:Destroy() markerLabel = nil end targetPos = nil end
delBtn.MouseButton1Click:Connect(function() clearMarker() if isAutoClicking then isAutoClicking = false toggleBtn.Text, toggleBtn.BackgroundColor3 = "Auto Click: OFF [H]", Color3.fromRGB(200, 50, 50) end end)

UIS.InputBegan:Connect(function(input)
	if not isPicking then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		local p = input.Position
		if p.X >= mainFrame.AbsolutePosition.X and p.X <= mainFrame.AbsolutePosition.X + mainFrame.AbsoluteSize.X and p.Y >= mainFrame.AbsolutePosition.Y and p.Y <= mainFrame.AbsolutePosition.Y + mainFrame.AbsoluteSize.Y then return end
		clearMarker() targetPos = Vector2.new(p.X, p.Y + 58)
		markerLabel = Instance.new("TextLabel", controlGui) markerLabel.Size, markerLabel.Position, markerLabel.BackgroundColor3, markerLabel.Text, markerLabel.TextScaled, markerLabel.TextColor3 = UDim2.new(0, 50, 0, 20), UDim2.new(0, p.X - 25, 0, p.Y - 10), Color3.fromRGB(255, 0, 0), "[ X ]", true, Color3.fromRGB(255, 255, 255)
		markerLabel.Font, markerLabel.ZIndex = Enum.Font.SourceSansBold, 10 Instance.new("UICorner", markerLabel).CornerRadius = UDim.new(0, 4)
		isPicking, pickBtn.Text, pickBtn.BackgroundColor3 = false, "Chọn vị trí", Color3.fromRGB(0, 120, 200)
	end
end)
delayBox.FocusLost:Connect(function() clickDelay = tonumber(delayBox.Text) or clickDelay delayBox.Text = tostring(clickDelay) end)

-- 5. HÀM DÙNG CHUNG BẬT/TẮT ĐỒNG BỘ 100%
local function toggleAutoClick()
	if isToggling then return end
	if not markerLabel or not targetPos then
		isToggling = true local oldColor = toggleBtn.BackgroundColor3 toggleBtn.Text, toggleBtn.BackgroundColor3 = "Chưa chọn vị trí!", Color3.fromRGB(230, 120, 0) task.wait(0.8)
		toggleBtn.Text, toggleBtn.BackgroundColor3, isToggling = isAutoClicking and "Auto Click: ON [H]" or "Auto Click: OFF [H]", oldColor, false return
	end
	isAutoClicking = not isAutoClicking
	toggleBtn.Text, toggleBtn.BackgroundColor3 = isAutoClicking and "Auto Click: ON [H]" or "Auto Click: OFF [H]", isAutoClicking and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
end
toggleBtn.MouseButton1Click:Connect(toggleAutoClick)

-- 6. ẨN VÀ TẮT GUI
local function toggleGui() mainFrame.Visible = not mainFrame.Visible restoreBtn.Visible = not mainFrame.Visible if markerLabel then markerLabel.Visible = mainFrame.Visible end end
miniBtn.MouseButton1Click:Connect(toggleGui) restoreBtn.MouseButton1Click:Connect(toggleGui)
closeBtn.MouseButton1Click:Connect(function() controlGui:Destroy() script:Destroy() end)

-- 7. LẮNG NGHE PHÍM TẮT BÀN PHÍM
UIS.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == TOGGLE_KEY then toggleAutoClick()
	elseif input.KeyCode == GUI_KEY then toggleGui() end
end)

-- 8. VÒNG LẶP CLICK NGẦM
task.spawn(function()
	while true do task.wait(clickDelay)
		if isAutoClicking and targetPos and markerLabel then
			VIM:SendMouseButtonEvent(targetPos.X, targetPos.Y, 0, true, game, 0) task.wait(0.01)
			VIM:SendMouseButtonEvent(targetPos.X, targetPos.Y, 0, false, game, 0)
		end
	end
end)
