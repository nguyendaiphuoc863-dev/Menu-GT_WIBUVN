local dragStart
local startPos
local dragInput

local function updateDrag(input)
    if not dragStart or not startPos then
        return
    end

    local delta = input.Position - dragStart

    mainFrame.Position = UDim2.new(
        startPos.X.Scale,
        startPos.X.Offset + delta.X,
        startPos.Y.Scale,
        startPos.Y.Offset + delta.Y
    )
end

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragStart = input.Position
        startPos = mainFrame.Position
        dragInput = input

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End
                or input.UserInputState == Enum.UserInputState.Cancel then

                if dragInput == input then
                    dragInput = nil
                    dragStart = nil
                    startPos = nil
                end
            end
        end)
    end
end)

mainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        dragInput = input
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragInput and input == dragInput then
        updateDrag(input)
    end
end)

local function clearMarker()
    if markerLabel then
        markerLabel:Destroy()
        markerLabel = nil
    end

    targetPos = nil
end

local function isInsideMainFrame(position)
    local framePosition = mainFrame.AbsolutePosition
    local frameSize = mainFrame.AbsoluteSize

    return position.X >= framePosition.X
        and position.X <= framePosition.X + frameSize.X
        and position.Y >= framePosition.Y
        and position.Y <= framePosition.Y + frameSize.Y
end

local function createMarker(position)
    clearMarker()

    targetPos = Vector2.new(position.X, position.Y + 58)

    markerLabel = Instance.new("TextLabel")
    markerLabel.Size = UDim2.new(0, 50, 0, 20)
    markerLabel.Position = UDim2.new(0, position.X - 25, 0, position.Y - 10)
    markerLabel.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    markerLabel.Text = "[ X ]"
    markerLabel.TextScaled = true
    markerLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    markerLabel.Font = Enum.Font.SourceSansBold
    markerLabel.ZIndex = 10
    markerLabel.Parent = controlGui

    Instance.new("UICorner", markerLabel).CornerRadius = UDim.new(0, 4)
end

