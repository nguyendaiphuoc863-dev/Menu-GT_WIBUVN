	StateBtn.Size = UDim2.new(0, 75, 0, 28)
	StateBtn.Position = UDim2.new(1, -85, 0, 10)
	
	-- Thiết lập hiển thị đặc biệt cho nút Fix Lag (ID: FixLag) thành RUN màu xanh dương cố định
	if id == "FixLag" then
