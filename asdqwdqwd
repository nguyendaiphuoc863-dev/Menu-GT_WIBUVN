local function GetRoot(Player)
	if not Player then
		return nil
	end
	local Character = Player.Character
	if not Character then
		return nil
	end
	return Character:FindFirstChild("HumanoidRootPart")
end

local function StartNoclip()
	local Character = LocalPlayer.Character
	if not Character then
		return
	end

	OriginalCanCollide = {}

	for _, Object in ipairs(Character:GetDescendants()) do
		if Object:IsA("BasePart") then
			OriginalCanCollide[Object] = Object.CanCollide
			Object.CanCollide = false
		end
	end

	if NoclipConnection then
		NoclipConnection:Disconnect()
		NoclipConnection = nil
	end

	NoclipConnection = RunService.Stepped:Connect(function()
		if not FollowEnabled then
			return
		end

		local CurrentCharacter = LocalPlayer.Character
		if not CurrentCharacter then
			return
		end

		for _, Object in ipairs(CurrentCharacter:GetDescendants()) do
			if Object:IsA("BasePart") then
				Object.CanCollide = false
			end
		end
	end)
end

local function StopNoclip()
	if NoclipConnection then
		NoclipConnection:Disconnect()
		NoclipConnection = nil
	end

	local Character = LocalPlayer.Character

	if Character then
		for _, Object in ipairs(Character:GetDescendants()) do
			if Object:IsA("BasePart") then
				if OriginalCanCollide[Object] ~= nil then
					Object.CanCollide = OriginalCanCollide[Object]
				else
					if Object.Name == "HumanoidRootPart" then
						Object.CanCollide = false
					else
						Object.CanCollide = true
					end
				end
			end
		end
	end

	OriginalCanCollide = {}
end

local function CreateFlySystem()
	local Character = LocalPlayer.Character
	local Root = GetRoot(LocalPlayer)

	if not Character or not Root then
		return false
	end

	if FlyVelocity then
		FlyVelocity:Destroy()
		FlyVelocity = nil
	end

	if FlyOrientation then
		FlyOrientation:Destroy()
		FlyOrientation = nil
	end

	if FlyAttachment then
		FlyAttachment:Destroy()
		FlyAttachment = nil
	end

	FlyAttachment = Instance.new("Attachment")
	FlyAttachment.Name = "PlayerFollowFlyAttachment"
	FlyAttachment.Parent = Root

	FlyVelocity = Instance.new("LinearVelocity")
	FlyVelocity.Name = "PlayerFollowFlyVelocity"
	FlyVelocity.Attachment0 = FlyAttachment
	FlyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
	FlyVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	FlyVelocity.MaxForce = math.huge
	FlyVelocity.VectorVelocity = Vector3.zero
	FlyVelocity.Parent = Root

	FlyOrientation = Instance.new("AlignOrientation")
	FlyOrientation.Name = "PlayerFollowFlyOrientation"
	FlyOrientation.Attachment0 = FlyAttachment
	FlyOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	FlyOrientation.MaxTorque = math.huge
	FlyOrientation.MaxAngularVelocity = math.huge
	FlyOrientation.Responsiveness = 35
	FlyOrientation.RigidityEnabled = false
	FlyOrientation.Parent = Root

	local Humanoid = Character:FindFirstChildOfClass("Humanoid")

	if Humanoid then
		Humanoid.AutoRotate = false
		Humanoid.PlatformStand = true
	end

	StartNoclip()

	return true
end

local function StopFlySystem()
	if FlyVelocity then
		FlyVelocity.VectorVelocity = Vector3.zero
		FlyVelocity:Destroy()
		FlyVelocity = nil
	end

	if FlyOrientation then
		FlyOrientation:Destroy()
		FlyOrientation = nil
	end

	if FlyAttachment then
		FlyAttachment:Destroy()
		FlyAttachment = nil
	end

	StopNoclip()

	local Character = LocalPlayer.Character

	if Character then
		local Humanoid = Character:FindFirstChildOfClass("Humanoid")

		if Humanoid then
			Humanoid.PlatformStand = false
			Humanoid.AutoRotate = true
			Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end
end

local function GetTargetPosition(TargetRoot)
	return TargetRoot.Position + Vector3.new(0, FOLLOW_HEIGHT, 0) - TargetRoot.CFrame.LookVector * FOLLOW_DISTANCE
end

local function UpdateFlying()
	if not FollowEnabled then
		return
	end

	local MyRoot = GetRoot(LocalPlayer)
	local TargetRoot = GetRoot(SelectedPlayer)

	if not MyRoot or not TargetRoot then
		Status.Text = "Status: Waiting for character..."
		return
	end

	if not FlyVelocity or not FlyOrientation then
		if not CreateFlySystem() then
			return
		end
	end

	local TargetPosition = GetTargetPosition(TargetRoot)
	local CurrentPosition = MyRoot.Position
	local Offset = TargetPosition - CurrentPosition
	local Distance = Offset.Magnitude

	if Distance <= ARRIVE_DISTANCE then
		FlyVelocity.VectorVelocity = Vector3.zero
		FlyOrientation.CFrame = CFrame.lookAt(CurrentPosition, TargetRoot.Position)
		Status.Text = "Status: Following " .. SelectedPlayer.DisplayName
		return
	end

	local Direction = Offset.Unit
	local SpeedMultiplier = math.clamp(Distance / 15, 0.35, 1)
	local CurrentSpeed = FlySpeed * SpeedMultiplier

	FlyVelocity.VectorVelocity = Direction * CurrentSpeed
	FlyOrientation.CFrame = CFrame.lookAt(CurrentPosition, TargetRoot.Position)

	if Distance > 10 then
		Status.Text = "Status: Flying to " .. SelectedPlayer.DisplayName
	else
		Status.Text = "Status: Following " .. SelectedPlayer.DisplayName
	end
end

local function StartFollow()
	if FollowingConnection then
		FollowingConnection:Disconnect()
		FollowingConnection = nil
	end

	if not CreateFlySystem() then
		Status.Text = "Status: Character not ready"
		FollowEnabled = false
		return
	end

	FollowEnabled = true

	FollowingConnection = RunService.Heartbeat:Connect(function()
		if not FollowEnabled then
			return
		end

		if not SelectedPlayer or not SelectedPlayer.Parent then
			FollowEnabled = false
			StopFlySystem()
			return
		end

		UpdateFlying()
	end)
end

local function StopFollow()
	FollowEnabled = false

	if FollowingConnection then
		FollowingConnection:Disconnect()
		FollowingConnection = nil
	end

	StopFlySystem()

	FollowButton.Text = "FOLLOW"
	FollowButton.BackgroundColor3 = Color3.fromRGB(55, 120, 220)
	Status.Text = "Status: Follow stopped"
end

