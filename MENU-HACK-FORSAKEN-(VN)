local function startSpeed()
	if SPEED_CONNECTION then return end

	SPEED_CONNECTION = RunService.Heartbeat:Connect(function(deltaTime)
		if not SPEED_ENABLED then return end

		local character = LocalPlayer.Character
		if not character then return end

		local rootPart = character:FindFirstChild("HumanoidRootPart")
		local humanoid = character:FindFirstChildOfClass("Humanoid")

		if rootPart and humanoid and humanoid.Health > 0 and humanoid.MoveDirection.Magnitude > 0 then
			local moveDirectionXZ = Vector3.new(humanoid.MoveDirection.X, 0, humanoid.MoveDirection.Z).Unit
			local walkSpeed = humanoid.WalkSpeed
			local finalMultiplier = SPEED_MULTIPLIER

			if walkSpeed > 24 then
				finalMultiplier = 1.0
			elseif walkSpeed > 16 then
				finalMultiplier = math.min(SPEED_MULTIPLIER, 1.08)
			end

			if finalMultiplier > 1 then
				local calculatedMove = moveDirectionXZ * (walkSpeed * (finalMultiplier - 1)) * deltaTime
				local currentCFrame = rootPart.CFrame
				local newPosition = currentCFrame.Position + calculatedMove

				local targetCFrame = CFrame.new(newPosition.X, currentCFrame.Position.Y, newPosition.Z) * (currentCFrame - currentCFrame.Position)
				character:PivotTo(targetCFrame)
			end

			pcall(function()
				rootPart.AssemblyLinearVelocity = Vector3.new(
					moveDirectionXZ.X * (walkSpeed * finalMultiplier),
					rootPart.AssemblyLinearVelocity.Y,
					moveDirectionXZ.Z * (walkSpeed * finalMultiplier)
				)
				rootPart.AssemblyAngularVelocity = Vector3.zero
			end)
		end
	end)

	HITBOX_CONNECTION = RunService.RenderStepped:Connect(function()
		local character = LocalPlayer.Character
		if not character then return end

		local rootPart = character:FindFirstChild("HumanoidRootPart")
		if not rootPart then return end

		local queryHitbox = character:FindFirstChild("QueryHitbox", true)
		if queryHitbox and queryHitbox:IsA("BasePart") then
			queryHitbox.CFrame = rootPart.CFrame
		end
	end)
end

local function stopSpeed()
	SPEED_ENABLED = false

	if SPEED_CONNECTION then
		SPEED_CONNECTION:Disconnect()
		SPEED_CONNECTION = nil
	end

	if HITBOX_CONNECTION then
		HITBOX_CONNECTION:Disconnect()
		HITBOX_CONNECTION = nil
	end

	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid and humanoid.Health > 0 then
		humanoid.WalkSpeed = NORMAL_WALK_SPEED
	end

	pcall(function()
		local character = LocalPlayer.Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if rootPart then
			rootPart.AssemblyLinearVelocity = Vector3.zero
		end
	end)
end

local function checkGenCompleted(gen)
	local attributes = gen:GetAttributes()
	if attributes then
		for name, value in pairs(attributes) do
			local lowerName = name:lower()
			if lowerName:find("progress") or lowerName:find("state") or lowerName:find("completed") then
				if value == true or value == 100 or value == 5 or tostring(value):lower() == "complete" then
					return true
				end
			end
		end
	end

	for _, ui in ipairs(gen:GetDescendants()) do
		if ui:IsA("TextLabel") or ui:IsA("TextBox") then
			local text = ui.Text:lower():gsub("%s+", "")
			if text:find("5/5") or text:find("4/4") or text:find("100%%") or text:find("complete") or text:find("finished") then
				return true
			end
		end

		if ui:IsA("Frame") and ui.Name:lower():find("bar") then
			if ui.Size.X.Scale >= 0.98 then
				return true
			end
		end
	end

	local marker = gen:FindFirstChild("Light", true) or gen:FindFirstChild("Lamp", true) or gen:FindFirstChild("Neon", true)
	if marker and marker:IsA("BasePart") then
		if marker.Color == Color3.fromRGB(0, 255, 0) or marker.Material == Enum.Material.Neon then
			return true
		end
	end

	return false
end

local function setupGenerator(gen)
	if not gen:IsA("Model") then return end

	local highlight = gen:FindFirstChild("GEN_ESP")
	if not highlight then
		highlight = Instance.new("Highlight")
