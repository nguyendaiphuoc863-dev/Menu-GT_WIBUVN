local USE_TOUCH_INPUT = UIS.TouchEnabled
local ACTIVE_TOUCH_ID = 17
local ACTIVE_INPUT_MODE = nil
local function sendPointerMove(x, y)
	if USE_TOUCH_INPUT and VirtualInputManager.SendTouchEvent then
		if ACTIVE_INPUT_MODE ~= "Touch" then return true end
		return pcall(function()
			VirtualInputManager:SendTouchEvent(ACTIVE_TOUCH_ID, Enum.UserInputState.Change, x, y)
		end)
	end
	ACTIVE_INPUT_MODE = "Mouse"
	return pcall(function()
		VirtualInputManager:SendMouseMoveEvent(x, y, game)
	end)
end
local function sendPointerDown(x, y)
	if USE_TOUCH_INPUT and VirtualInputManager.SendTouchEvent then
		local ok = pcall(function()
			VirtualInputManager:SendTouchEvent(ACTIVE_TOUCH_ID, Enum.UserInputState.Begin, x, y)
		end)
		if ok then ACTIVE_INPUT_MODE = "Touch" return true end
	end
	ACTIVE_INPUT_MODE = "Mouse"
	return pcall(function()
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
	end)
end
local function sendPointerUp(x, y)
	if ACTIVE_INPUT_MODE == "Touch" and VirtualInputManager.SendTouchEvent then
		local ok = pcall(function()
			VirtualInputManager:SendTouchEvent(ACTIVE_TOUCH_ID, Enum.UserInputState.End, x, y)
		end)
		ACTIVE_INPUT_MODE = nil
		if ok then return true end
	end
	ACTIVE_INPUT_MODE = nil
	return pcall(function()
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
	end)
end
local function sendPointerTap(x, y)
	sendPointerMove(x, y)
	task.wait(0.015)
	sendPointerDown(x, y)
	task.wait(0.025)
	sendPointerUp(x, y)
end

