local function processBoardClean()
	local isValidGen, genMsg = hasValidFlowServerGenerator()
	if not isValidGen then
		return
	end
	local puzzleUI = PlayerGui:FindFirstChild("PuzzleUI")
	if not puzzleUI or not puzzleUI.Enabled then
		cachedSolutions = {}
		blockerClearCount = {}
		return
	end
	local gridFolder = puzzleUI:FindFirstChild("Container")
		and puzzleUI.Container:FindFirstChild("GridHolder")
		and puzzleUI.Container.GridHolder:FindFirstChild("Grid")
	if not gridFolder then
		return
	end
	local grid, maxR, maxC, boardSig = buildGridMap(gridFolder)
	if not grid or boardSig == "" then
		return
	end
	local colorGroups = {}
	for r = 1, maxR do
		for c = 1, maxC do
			local cell = grid[r][c]
			if cell and cell.hasCircle and cell.colorKey then
				if not colorGroups[cell.colorKey] then
					colorGroups[cell.colorKey] = {}
				end
				table.insert(colorGroups[cell.colorKey], cell)
			end
		end
	end
	local allPairs = {}
	local unfinishedPairs = {}
	local connectedPairsByColor = {}
	for colorKey, cells in pairs(colorGroups) do
		local firstNode, secondNode = nil, nil
		for _, node in ipairs(cells) do
			if not firstNode then
				firstNode = node
			elseif not secondNode then
				secondNode = node
				break
			end
		end
		if firstNode and secondNode then
			local pObj = {colorKey = colorKey, c1 = firstNode, c2 = secondNode}
			table.insert(allPairs, pObj)
			if not firstNode.hasLine or not secondNode.hasLine then
				table.insert(unfinishedPairs, pObj)
			else
				connectedPairsByColor[colorKey] = pObj
			end
		end
	end
	if #allPairs == 0 then
		return
	end
	if #unfinishedPairs == 0 then
		return
	end
	local solutionList = cachedSolutions[boardSig]
	if solutionList == nil then
		task.wait()
		local solved = solveFullBoardClean(grid, maxR, maxC, allPairs)
		cachedSolutions[boardSig] = solved or false
		solutionList = cachedSolutions[boardSig]
	end
	if type(solutionList) == "table" then
		for i = 1, #solutionList do
			if not states.Flow then return end
			local item = solutionList[i]
			local latestGrid = buildGridMap(gridFolder)
			if latestGrid then
				local c1Latest = latestGrid[item.pair.c1.r][item.pair.c1.c]
				local c2Latest = latestGrid[item.pair.c2.r][item.pair.c2.c]
				if not c1Latest.hasLine or not c2Latest.hasLine then
					local latestPath = {}
					local blockingColors = {}
					for k, pCell in ipairs(item.path) do
						local cellNow = latestGrid[pCell.r][pCell.c]
						if k > 1 and k < #item.path and cellNow.hasLine and cellNow.lineColorKey then
							blockingColors[cellNow.lineColorKey] = true
						end
						table.insert(latestPath, cellNow)
					end
					local didClearBlocker = false
					for bColor, _ in pairs(blockingColors) do
						local bPair = connectedPairsByColor[bColor]
						local clearKey = boardSig .. "_" .. bColor
						local count = blockerClearCount[clearKey] or 0
						if bPair and count < 2 then
							blockerClearCount[clearKey] = count + 1
							clearPairLine(bPair)
							didClearBlocker = true
						end
					end
					if didClearBlocker then
						return
					end
					dragAlongFramesSmooth(latestPath)
					return
				end
			end
		end
	end
	local currentBlocked = {}
	for r = 1, maxR do
		for c = 1, maxC do
			local cell = grid[r][c]
			if cell and (cell.hasCircle or cell.hasLine) then
				currentBlocked[r * 100 + c] = true
			end
		end
	end
	for _, pair in ipairs(unfinishedPairs) do
		local shortPath = findCleanShortestPath(grid, maxR, maxC, pair.c1, pair.c2, currentBlocked)
		if shortPath then
			dragAlongFramesSmooth(shortPath)
			return
		end
	end
	for bColor, bPair in pairs(connectedPairsByColor) do
		local clearKey = boardSig .. "fallback" .. bColor
		if not blockerClearCount[clearKey] then
			blockerClearCount[clearKey] = true
			cachedSolutions[boardSig] = nil
			clearPairLine(bPair)
			return
		end
	end
end
