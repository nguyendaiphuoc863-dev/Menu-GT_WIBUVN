local function isTargetCircleColor(color)
	if not color then return false end
	return math.abs(math.round(color.R * 255) - 240) <= 3
		and math.abs(math.round(color.G * 255) - 240) <= 3
		and math.abs(math.round(color.B * 255) - 240) <= 3
end
local function getPathColor(path)
	local ok, color = pcall(function()
		return path.Color3 or path.Color
	end)
	if not ok then return nil end
	if typeof(color) == "Color3" then return color end
	if typeof(color) == "ColorSequence" and #color.Keypoints > 0 then
		return color.Keypoints[1].Value
	end
	return nil
end
local function evaluateBezier(p0, p1, p2, p3, t)
	local u = 1 - t
	return p0 * u^3 + p1 * (3 * u^2 * t) + p2 * (3 * u * t^2) + p3 * t^3
end
local function getNormalizedCurvePoints(path, circle)
	local size = circle.AbsoluteSize
	if size.X <= 0 or size.Y <= 0 then return {} end
	local points = {}
	local ok = pcall(function()
		path:GetPositionOnCurve(0.5)
	end)
	if ok then
		for index = 1, 19 do
			local point = path:GetPositionOnCurve(index / 20)
			table.insert(points, Vector2.new(
				point.X.Scale + point.X.Offset / size.X,
				point.Y.Scale + point.Y.Offset / size.Y
				))
		end
		return points
	end
	local success, controls = pcall(function()
		return path:GetControlPoints()
	end)
	if not success or type(controls) ~= "table" or #controls < 2 then
		return points
	end
	local function normalize(position)
		return Vector2.new(
			position.X.Scale + position.X.Offset / size.X,
			position.Y.Scale + position.Y.Offset / size.Y
		)
	end
	for index = 1, #controls - 1 do
		local first = controls[index]
		local second = controls[index + 1]
		local p0 = normalize(first.Position)
		local p3 = normalize(second.Position)
		local p1 = normalize(first.Position + first.RightTangent)
		local p2 = normalize(second.Position + second.LeftTangent)
		for step = 0, 10 do
			table.insert(points, evaluateBezier(p0, p1, p2, p3, step / 10))
		end
	end
	return points
end
local function isTipInsideTargetPath(tip, path, circle)
	local circlePos = circle.AbsolutePosition
	local circleSize = circle.AbsoluteSize
	if circleSize.X <= 0 or circleSize.Y <= 0 then return false end
	local points = getNormalizedCurvePoints(path, circle)
	if #points == 0 then return false end
	local tipCenter = tip.AbsolutePosition + tip.AbsoluteSize * 0.5
	local tipNorm = Vector2.new(
		(tipCenter.X - circlePos.X) / circleSize.X,
		(tipCenter.Y - circlePos.Y) / circleSize.Y
	)
	local center = Vector2.new(0.5, 0.5)
	local tipAngle = math.atan2(tipNorm.Y - center.Y, tipNorm.X - center.X)
	local tipRadius = math.max(
		tip.AbsoluteSize.X / circleSize.X,
		tip.AbsoluteSize.Y / circleSize.Y
	) * 0.5
	local angleTolerance = math.clamp(tipRadius * 1.1, 0.04, 0.12)
	local distanceTolerance = math.clamp(tipRadius * 1.2, 0.025, 0.08)
	for _, point in ipairs(points) do
		if (tipNorm - point).Magnitude <= distanceTolerance then
			return true
		end
		local pointAngle = math.atan2(point.Y - center.Y, point.X - center.X)
		local angleDiff = math.abs(math.atan2(
			math.sin(tipAngle - pointAngle),
			math.cos(tipAngle - pointAngle)
			))
		if angleDiff <= angleTolerance then
			return true
		end
	end
	return false
end
