local function hasValidFlowServerGenerator()
	local mapFolder = workspace:FindFirstChild("Map")
	local ingameFolder = mapFolder and mapFolder:FindFirstChild("Ingame")
	local innerMap = ingameFolder and ingameFolder:FindFirstChild("Map")
	if not innerMap then
		return false, "Waiting for Map -> Ingame -> Map..."
	end
	local generators = {}
	for _, obj in ipairs(innerMap:GetDescendants()) do
		if obj:IsA("Model") and obj.Name == "Generator" then
			table.insert(generators, obj)
		end
	end
	if #generators == 0 then
		return false, "No Generator found in Map!"
	end
	local char = LocalPlayer.Character
	local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
	if root then
		local closestGen = nil
		local minDist = math.huge
		for _, gen in ipairs(generators) do
			local genPos = gen:GetPivot().Position
			local dist = (root.Position - genPos).Magnitude
			if dist < minDist then
				minDist = dist
				closestGen = gen
			end
		end
		if closestGen and minDist <= 35 then
			if isGeneratorFlowServer(closestGen) then
				return true, "Valid: FlowServerMinigame"
			else
				return false, "This Generator is not FlowServerMinigame"
			end
		end
	end
	for _, gen in ipairs(generators) do
		if isGeneratorFlowServer(gen) then
			return true, "Valid: FlowServerMinigame"
		end
	end
	return false, "No FlowServerMinigame Generator found"
end
