local function buildGridMap(gridFolder)
	local rawCells = {}
	for _, child in ipairs(gridFolder:GetChildren()) do
		if child:IsA("Frame") and child.Visible and child.AbsoluteSize.X > 10 and child.AbsoluteSize.Y > 10 then
			local hasLine, lineColorKey = hasActiveHalfLine(child)
			table.insert(rawCells, {
				frame = child,
				cx = child.AbsolutePosition.X + child.AbsoluteSize.X * 0.5,
				cy = child.AbsolutePosition.Y + child.AbsoluteSize.Y * 0.5,
				w = child.AbsoluteSize.X,
				h = child.AbsoluteSize.Y,
				hasLine = hasLine,
				lineColorKey = lineColorKey
			})
		end
	end
	local _, firstCell = next(rawCells)
	if not firstCell then return nil, 0, 0, "" end
	local tolX = firstCell.w * 0.35
	local tolY = firstCell.h * 0.35
	local rowCenters = {}
	local colCenters = {}
	local function registerCoord(list, val, tol)
		for _, v in ipairs(list) do
			if math.abs(v - val) <= tol then
				return
			end
		end
		table.insert(list, val)
	end
	for _, item in ipairs(rawCells) do
		registerCoord(rowCenters, item.cy, tolY)
		registerCoord(colCenters, item.cx, tolX)
	end
	table.sort(rowCenters)
	table.sort(colCenters)
	local function getNearestIndex(list, val)
		local bestIdx = 1
		local bestDiff = math.huge
		for idx, v in ipairs(list) do
			local diff = math.abs(v - val)
			if diff < bestDiff then
				bestDiff = diff
				bestIdx = idx
			end
		end
		return bestIdx
	end
	local grid = {}
	for r = 1, #rowCenters do
		grid[r] = {}
	end
	for _, item in ipairs(rawCells) do
		local r = getNearestIndex(rowCenters, item.cy)
		local c = getNearestIndex(colCenters, item.cx)
		local circleObj = item.frame:FindFirstChild("Circle", true)
		local hasCircle = (circleObj and circleObj:IsA("Frame") and circleObj.Visible)
		local colorKey = hasCircle and getColorKey(circleObj.BackgroundColor3) or nil
		grid[r][c] = {
			r = r,
			c = c,
			frame = item.frame,
			hasCircle = hasCircle,
			colorKey = colorKey,
			hasLine = item.hasLine,
			lineColorKey = item.lineColorKey,
			isWalkableTile = (not hasCircle),
			isEmpty = (not hasCircle) and (not item.hasLine)
		}
	end
	local sigParts = {tostring(#rowCenters) .. "x" .. tostring(#colCenters)}
	for r = 1, #rowCenters do
		for c = 1, #colCenters do
			local cell = grid[r][c]
			if cell and cell.hasCircle then
				table.insert(sigParts, string.format("%d_%d:%s", r, c, cell.colorKey or ""))
			end
		end
	end
	return grid, #rowCenters, #colCenters, table.concat(sigParts, "|")
end
local function hasReachablePathsForAll(grid, maxR, maxC, pairList, startIndex, blocked)
	local function key(r, c) return r * 100 + c end
	for i = startIndex, #pairList do
		local p = pairList[i]
		local queue = {{r = p.c1.r, c = p.c1.c}}
		local visited = {[key(p.c1.r, p.c1.c)] = true}
		local found = false
		local head = 1
		while head <= #queue do
			local curr = queue[head]
			head = head + 1
			if curr.r == p.c2.r and curr.c == p.c2.c then
				found = true
				break
			end
			for _, d in ipairs(DIRS) do
				local nr, nc = curr.r + d.dr, curr.c + d.dc
				local k = key(nr, nc)
				if nr >= 1 and nr <= maxR and nc >= 1 and nc <= maxC and not visited[k] and not blocked[k] then
					local nb = grid[nr][nc]
					if nb and ((nr == p.c2.r and nc == p.c2.c) or nb.isWalkableTile) then
						visited[k] = true
						table.insert(queue, {r = nr, c = nc})
					end
				end
			end
		end
		if not found then
			return false
		end
	end
	return true
end
local function findCleanShortestPath(grid, maxR, maxC, startCell, endCell, blockedMap)
	local function key(r, c) return r * 100 + c end
	local queue = {{r = startCell.r, c = startCell.c, lastDr = 0, lastDc = 0, turns = 0, dist = 0}}
	local bestCost = {[key(startCell.r, startCell.c)] = 0}
	local parent = {}
	local head = 1
	while head <= #queue do
		local curr = queue[head]
		head = head + 1
		if curr.r == endCell.r and curr.c == endCell.c then
			local pathCells = {}
			local trace = {r = endCell.r, c = endCell.c}
			while trace do
				table.insert(pathCells, 1, grid[trace.r][trace.c])
				trace = parent[key(trace.r, trace.c)]
			end
			return pathCells
		end
		for _, d in ipairs(DIRS) do
			local nr, nc = curr.r + d.dr, curr.c + d.dc
			local k = key(nr, nc)
			if nr >= 1 and nr <= maxR and nc >= 1 and nc <= maxC then
				local isDest = (nr == endCell.r and nc == endCell.c)
				local nb = grid[nr][nc]
				local isBlocked = blockedMap and blockedMap[k]
				if isDest or (nb and nb.isWalkableTile and not isBlocked) then
					local turnPenalty = (curr.lastDr ~= 0 or curr.lastDc ~= 0) and (curr.lastDr ~= d.dr or curr.lastDc ~= d.dc) and 1 or 0
					local newCost = (curr.dist + 1) * 10 + curr.turns + turnPenalty
					if not bestCost[k] or newCost < bestCost[k] then
						bestCost[k] = newCost
						parent[k] = {r = curr.r, c = curr.c}
						table.insert(queue, {
							r = nr,
							c = nc,
							lastDr = d.dr,
							lastDc = d.dc,
							turns = curr.turns + turnPenalty,
							dist = curr.dist + 1
						})
					end
				end
			end
		end
	end
	return nil
end
local function solveFullBoardClean(grid, maxR, maxC, allPairs)
	local blocked = {}
	local function key(r, c) return r * 100 + c end
	for r = 1, maxR do
		for c = 1, maxC do
			local cell = grid[r][c]
			if cell and cell.hasCircle then
				blocked[key(r, c)] = true
			end
		end
	end
	local solveOrder = table.clone(allPairs)
	table.sort(solveOrder, function(a, b)
		local distA = math.abs(a.c1.r - a.c2.r) + math.abs(a.c1.c - a.c2.c)
		local distB = math.abs(b.c1.r - b.c2.r) + math.abs(b.c1.c - b.c2.c)
		return distA < distB
	end)
	local finalPaths = {}
	local startTime = tick()
	local function solvePair(pairIdx)
		if tick() - startTime > 1.2 then return false end
		if pairIdx > #solveOrder then return true end
		local pair = solveOrder[pairIdx]
		local directShortPath = findCleanShortestPath(grid, maxR, maxC, pair.c1, pair.c2, blocked)
		if directShortPath then
			for k = 2, #directShortPath - 1 do
				blocked[key(directShortPath[k].r, directShortPath[k].c)] = true
			end
			if hasReachablePathsForAll(grid, maxR, maxC, solveOrder, pairIdx + 1, blocked) then
				finalPaths[pairIdx] = {pair = pair, path = directShortPath}
				if solvePair(pairIdx + 1) then
					return true
				end
				finalPaths[pairIdx] = nil
			end
			for k = 2, #directShortPath - 1 do
				blocked[key(directShortPath[k].r, directShortPath[k].c)] = nil
			end
		end
		local currentPath = {pair.c1}
		local function dfsDetour(cr, cc)
			if tick() - startTime > 1.2 then return false end
			if cr == pair.c2.r and cc == pair.c2.c then
				if hasReachablePathsForAll(grid, maxR, maxC, solveOrder, pairIdx + 1, blocked) then
					finalPaths[pairIdx] = {pair = pair, path = table.clone(currentPath)}
					if solvePair(pairIdx + 1) then
						return true
					end
					finalPaths[pairIdx] = nil
				end
				return false
			end
			local moves = {}
			for _, d in ipairs(DIRS) do
				local nr, nc = cr + d.dr, cc + d.dc
				local k = key(nr, nc)
				if nr >= 1 and nr <= maxR and nc >= 1 and nc <= maxC then
					local isDest = (nr == pair.c2.r and nc == pair.c2.c)
					local nb = grid[nr][nc]
					if isDest or (nb and nb.isWalkableTile and not blocked[k]) then
						local selfTouch = 0
						for _, adj in ipairs(DIRS) do
							local ar, ac = nr + adj.dr, nc + adj.dc
							if ar ~= cr or ac ~= cc then
								for _, node in ipairs(currentPath) do
									if node.r == ar and node.c == ac then
										selfTouch = selfTouch + 1
									end
								end
							end
						end
						if isDest or selfTouch == 0 then
							local wallDist = math.min(nr - 1, maxR - nr) + math.min(nc - 1, maxC - nc)
							local goalDist = math.abs(nr - pair.c2.r) + math.abs(nc - pair.c2.c)
							table.insert(moves, {
								r = nr,
								c = nc,
								isDest = isDest,
								score = (isDest and -1000 or 0) + wallDist * 2 + goalDist
							})
						end
					end
				end
			end
			table.sort(moves, function(a, b) return a.score < b.score end)
			for _, mv in ipairs(moves) do
				local k = key(mv.r, mv.c)
				if not mv.isDest then blocked[k] = true end
				table.insert(currentPath, grid[mv.r][mv.c])
				if dfsDetour(mv.r, mv.c) then
					return true
				end
				table.remove(currentPath)
				if not mv.isDest then blocked[k] = nil end
			end
			return false
		end
		return dfsDetour(pair.c1.r, pair.c1.c)
	end
	if solvePair(1) and #finalPaths == #solveOrder then
		return finalPaths
	end
	return nil
end
local function dragAlongFramesSmooth(pathCells)
	if not acquireMouse("Flow") then return false end
	if not pathCells or #pathCells < 2 then
		releaseMouse("Flow")
		return false
	end
	local _, firstCell = next(pathCells)
	local lastCell = pathCells[#pathCells]
	if not firstCell or not firstCell.frame or not lastCell or not lastCell.frame then
		releaseMouse("Flow")
		return false
	end
	local startX, startY = getCenterPosition(firstCell.frame)
	sendPointerMove(startX, startY, game)
	task.wait(0.03)
	sendPointerDown(startX, startY)
	task.wait(0.04)
	for idx = 2, #pathCells do
		local prevX, prevY = getCenterPosition(pathCells[idx - 1].frame)
		local nextX, nextY = getCenterPosition(pathCells[idx].frame)
		local steps = 5
		for i = 1, steps do
			local alpha = i / steps
			local curX = prevX + (nextX - prevX) * alpha
			local curY = prevY + (nextY - prevY) * alpha
			sendPointerMove(curX, curY, game)
			task.wait(0.0075)
		end
	end
	local endX, endY = getCenterPosition(lastCell.frame)
	sendPointerMove(endX, endY, game)
	task.wait(0.03)
	sendPointerUp(endX, endY)
	task.wait(0.1)
	local success = hasActiveHalfLine(firstCell.frame) and hasActiveHalfLine(lastCell.frame)
	releaseMouse("Flow")
	return success
end
