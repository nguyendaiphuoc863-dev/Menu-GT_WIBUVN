local function startSpeed()
	if SPEED_CONNECTION then return end

	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		NORMAL_WALK_SPEED = humanoid.WalkSpeed
	end

	SPEED_CONNECTION = RunService.RenderStepped:Connect(function(deltaTime)
		if not SPEED_ENABLED then return end

		local character = LocalPlayer.Character
		if not character then return end

		local rootPart = character:FindFirstChild("HumanoidRootPart")
		local humanoid = character:FindFirstChildOfClass("Humanoid")

		if rootPart and humanoid and humanoid.Health > 0 and humanoid.MoveDirection.Magnitude > 0 then
			local dragFactor = (SPEED_MULTIPLIER - 1) * NORMAL_WALK_SPEED * deltaTime
			local moveOffset = humanoid.MoveDirection * dragFactor

			rootPart.CFrame = rootPart.CFrame + moveOffset
		end
	end)
end

local function stopSpeed()
	SPEED_ENABLED = false

	if SPEED_CONNECTION then
		SPEED_CONNECTION:Disconnect()
		SPEED_CONNECTION = nil
	end

	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid and humanoid.Health > 0 then
		humanoid.WalkSpeed = NORMAL_WALK_SPEED
	end
end

local function updateGeneratorESP(gen)
	local highlight = gen:FindFirstChild("GEN_ESP")
	local progress = gen:FindFirstChild("Progress", true)

	if highlight and progress then
		if progress.Value >= 100 then
			highlight.FillColor = GEN_COLOR
		else
			highlight.FillColor = Color3.fromRGB(255,175,0)
		end
	end
end


local function doGenerator(gen)
	local main = gen:FindFirstChild("Main")
	if not main then return end

	local prompt = main:FindFirstChildOfClass("ProximityPrompt")
	if not prompt then return end

	local progress = gen:FindFirstChild("Progress", true)
	if progress and progress.Value >= 100 then
		updateGeneratorESP(gen)
		return
	end

	local remotes = gen:FindFirstChild("Remotes") or gen.Parent:FindFirstChild("Remotes")
	if not remotes then return end

	for _, re in pairs(remotes:GetChildren()) do
		if re:IsA("RemoteEvent") and re.Name == "RE" then
			pcall(function()
				re:FireServer(prompt)
			end)
		end
	end

	task.delay(0.5, function()
		updateGeneratorESP(gen)
	end)
end

local function startAutoGen()
	AUTO_GEN_THREAD = task.spawn(function()
		while AUTO_GEN and not ScreenGui:GetAttribute("Destroyed") do
			pcall(function()
				local mapFolder = workspace:FindFirstChild("Map")
				if mapFolder then
					local ingame = mapFolder:FindFirstChild("Ingame")
					if ingame and ingame:FindFirstChild("Map") then
						for _, gen in pairs(ingame.Map:GetChildren()) do
							if gen:IsA("Model") and (gen.Name == "Generator" or gen:FindFirstChild("Progress", true)) then
								doGenerator(gen)
								task.wait(0.1)
							end
						end
					end
				end
			end)
			task.wait(1)
		end

		AUTO_GEN_THREAD = nil
	end)
end

local function setupGenerator(gen)
	if not gen:IsA("Model") then return end
	if GEN_CACHE[gen] then return end

	local highlight = gen:FindFirstChild("GEN_ESP")
	if not highlight then
		highlight = Instance.new("Highlight")
		highlight.Name = "GEN_ESP"
		highlight.Adornee = gen
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = gen
	end

	GEN_CACHE[gen] = true

	local progress = gen:FindFirstChild("Progress", true)
	if progress then
		local function updateColor()
			if highlight and highlight.Parent then
				highlight.FillColor = (progress.Value >= 100)
					and GEN_COLOR
					or Color3.fromRGB(255,175,0)
			end
		end
		
		updateColor()

		if not progress:FindFirstChild("ESP_CONNECTION") then
			local tag = Instance.new("BoolValue")
			tag.Name = "ESP_CONNECTION"
			tag.Parent = progress

			progress:GetPropertyChangedSignal("Value"):Connect(updateColor)
		end
	end
end

local function applyGenESP()
	if GEN_CONNECTION then return end
	
	GEN_CONNECTION = task.spawn(function()
		while GEN_ESP and not ScreenGui:GetAttribute("Destroyed") do
			pcall(function()
				local mapFolder = workspace:FindFirstChild("Map")
				local ingame = mapFolder and mapFolder:FindFirstChild("Ingame")
				local currentMap = ingame and ingame:FindFirstChild("Map")
				
				if currentMap then
					for _, obj in pairs(currentMap:GetChildren()) do
						if obj:IsA("Model") and obj.Name == "Generator" then
							setupGenerator(obj) 
						end
					end
				end
			end)
			task.wait(1) 
		end

		GEN_CONNECTION = nil
	end)
end

local function removeGenESP()
	if GEN_CONNECTION then
		task.cancel(GEN_CONNECTION)
		GEN_CONNECTION = nil
	end

	for gen, _ in pairs(GEN_CACHE) do
		if gen and gen:FindFirstChild("GEN_ESP") then
			gen.GEN_ESP:Destroy()
		end
	end

	GEN_CACHE = {}
end

local function setupItemESP(tool)
	if not tool:IsA("Tool") then return end
	if tool:FindFirstChild("ITEM_ESP") then return end

	local h = Instance.new("Highlight")
	h.Name = "ITEM_ESP"
	h.Adornee = tool
	h.FillColor = ITEM_COLOR
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = tool
end

local function applyItemESP()
	for _, obj in pairs(Ingame:GetDescendants()) do
		if obj:IsA("Tool") then
			setupItemESP(obj)
		end
	end

	if not ITEM_CONNECTION then
		ITEM_CONNECTION = Ingame.DescendantAdded:Connect(function(obj)
			if ScreenGui:GetAttribute("Destroyed") then
				ITEM_CONNECTION:Disconnect()
				ITEM_CONNECTION = nil
				return
			end

			if ITEM_ESP and obj:IsA("Tool") then
				setupItemESP(obj)
			end
		end)
	end
end

local function removeItemESP()
	for _, obj in pairs(workspace:GetDescendants()) do
		local h = obj:FindFirstChild("ITEM_ESP")
		if h then h:Destroy() end
	end

	if ITEM_CONNECTION then
		ITEM_CONNECTION:Disconnect()
		ITEM_CONNECTION = nil
	end
end

