local function hasActiveHalfLine(cellFrame)
	for _, desc in ipairs(cellFrame:GetDescendants()) do
		if desc:IsA("GuiObject") and desc.Name ~= "Circle" and not desc:IsA("TextButton") and not desc:IsA("TextLabel") then
