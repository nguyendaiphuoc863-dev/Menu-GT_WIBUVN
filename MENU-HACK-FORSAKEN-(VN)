local function checkGenCompleted(gen)
    local attributes = gen:GetAttributes()
    if attributes then
        for name, value in pairs(attributes) do
            local lowerName = name:lower()
            if lowerName:find("progress") or lowerName:find("state") or lowerName:find("completed") then
                if value == true or value == 100 or value == 5 or tostring(value):lower() == "complete" then
                    return true
                end
            end
        end
    end

    for _, ui in ipairs(gen:GetDescendants()) do
        if ui:IsA("TextLabel") or ui:IsA("TextBox") then
            local text = ui.Text:lower():gsub("%s+", "")
            if text:find("5/5") or text:find("4/4") or text:find("100%%") or text:find("complete") or text:find("finished") then
                return true
            end
        end

        if ui:IsA("Frame") and ui.Name:lower():find("bar") then
            if ui.Size.X.Scale >= 0.98 then
                return true
            end
        end
    end

    local marker = gen:FindFirstChild("Light", true) or gen:FindFirstChild("Lamp", true) or gen:FindFirstChild("Neon", true)
    if marker and marker:IsA("BasePart") then
        if marker.Color == Color3.fromRGB(0, 255, 0) or marker.Material == Enum.Material.Neon then
            return true
        end
    end

    return false
end

local function setupGenerator(gen)
    if not gen:IsA("Model") then return end
    
    local highlight = gen:FindFirstChild("GEN_ESP")
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "GEN_ESP"
        highlight.Adornee = gen
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 0.4
        highlight.OutlineTransparency = 0.1
        highlight.OutlineColor = GEN_OUTLINE_COLOR
        highlight.Parent = gen
    end

    GEN_CACHE[gen] = true

    if highlight and highlight.Parent then
        if checkGenCompleted(gen) then
            highlight.FillColor = GEN_COLOR_COMPLETED
        else
            highlight.FillColor = GEN_COLOR_INCOMPLETE
        end
    end
end

local function applyGenESP()
    if GEN_CONNECTION then return end
    
    GEN_CONNECTION = task.spawn(function()
        while GEN_ESP and not ScreenGui:GetAttribute("Destroyed") do
            pcall(function()
                local mapFolder = workspace:FindFirstChild("Map")
                local ingame = mapFolder and mapFolder:FindFirstChild("Ingame")
                local currentMap = ingame and ingame:FindFirstChild("Map")
                
                if currentMap then
                    local foundCount = 0
                    for _, obj in pairs(currentMap:GetChildren()) do
                        if obj:IsA("Model") and obj.Name == "Generator" then
                            setupGenerator(obj)
                            foundCount = foundCount + 1
                        end
                    end
                end
            end)

            task.wait(1)
        end

        GEN_CONNECTION = nil
    end)
end

local function removeGenESP()
    if GEN_CONNECTION then
        task.cancel(GEN_CONNECTION)
        GEN_CONNECTION = nil
    end

    for gen, _ in pairs(GEN_CACHE) do
        if gen and gen.Parent then
            local highlight = gen:FindFirstChild("GEN_ESP")
            if highlight then highlight:Destroy() end
        end
    end

    GEN_CACHE = {}
end

local function setupItemESP(tool)
    if not tool:IsA("Tool") then return end
    if tool:FindFirstChild("ITEM_ESP") then return end

    task.defer(function()
        if not tool:IsDescendantOf(workspace) then return end
        
        if #tool:GetChildren() == 0 then
            task.wait(0.1)
        end
        
        if not tool:IsDescendantOf(workspace) or tool:FindFirstChild("ITEM_ESP") then return end

        local h = Instance.new("Highlight")
        h.Name = "ITEM_ESP"
        h.Adornee = tool
        h.FillColor = ITEM_COLOR
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Parent = tool
    end)
end

local function applyItemESP()
    ITEM_ESP = true 

    for _, obj in pairs(Ingame:GetDescendants()) do
        if obj:IsA("Tool") then 
            setupItemESP(obj) 
        end
    end

    if not ITEM_CONNECTION then
        ITEM_CONNECTION = Ingame.DescendantAdded:Connect(function(obj)
            if ScreenGui:GetAttribute("Destroyed") then 
                ITEM_CONNECTION:Disconnect() 
                ITEM_CONNECTION = nil 
                return 
            end
            
            if ITEM_ESP and obj:IsA("Tool") then 
                setupItemESP(obj) 
            end
        end)
    end
end

local function removeItemESP()
    ITEM_ESP = false

    for _, obj in pairs(Ingame:GetDescendants()) do
        local h = obj:FindFirstChild("ITEM_ESP")
        if h then 
            h:Destroy() 
        end
    end

    if ITEM_CONNECTION then 
        ITEM_CONNECTION:Disconnect() 
        ITEM_CONNECTION = nil 
    end
end

local function setupGearESP(object, color, espName)
    if not GEAR_ESP or object:FindFirstChild(espName) then return false end 
    if not object:IsDescendantOf(workspace) then return false end

    local h = Instance.new("Highlight")
    h.Name = espName
    h.Adornee = object
    h.FillColor = color
    h.OutlineColor = Color3.fromRGB(255, 255, 255)
    h.FillTransparency = 0.4
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = ScreenGui
    
    local connection
    connection = object.AncestryChanged:Connect(function()
        if not object:IsDescendantOf(workspace) then
            h:Destroy()
            if connection then connection:Disconnect() end
        end
    end)

    return true
end

local function isGear(obj)
    if obj:IsA("Model") or obj:IsA("MeshPart") or obj:IsA("BasePart") then
        local nameLower = string.lower(obj.Name)
        if string.find(nameLower, "gear") then
            return true
        end
    end
    return false
end

local function applyGearESP()
    GEAR_ESP = true
    
    task.spawn(function()
        local descendants = Ingame:GetDescendants()
        for _, obj in pairs(descendants) do
            if not GEAR_ESP then break end
            
            if isGear(obj) then
                local success = setupGearESP(obj, GEAR_COLOR, "GEAR_ESP_TAG")
               
                if success then
                    task.wait(0.15) 
                end
            end
        end
    end)
    
    if GEAR_CONNECTION then GEAR_CONNECTION:Disconnect() end
    GEAR_CONNECTION = Ingame.DescendantAdded:Connect(function(obj)
        if GEAR_ESP and isGear(obj) then
            task.wait(0.15)
            if GEAR_ESP then
                setupGearESP(obj, GEAR_COLOR, "GEAR_ESP_TAG")
            end
        end
    end)
end

local function removeGearESP()
    GEAR_ESP = false
    
    if GEAR_CONNECTION then 
        GEAR_CONNECTION:Disconnect() 
        GEAR_CONNECTION = nil 
    end
    
    for _, tag in pairs(ScreenGui:GetChildren()) do
        if tag:IsA("Highlight") then
            tag:Destroy()
        end
    end
end

