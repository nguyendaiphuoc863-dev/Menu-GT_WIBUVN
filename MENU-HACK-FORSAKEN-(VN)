task.spawn(function()
    while true do
        task.wait(0.05)
        
        if STAMINA_ENABLED and SprintModule then
            pcall(function()
                if SprintModule.Stamina then SprintModule.Stamina = 100 end
                if SprintModule.CurrentStamina then SprintModule.CurrentStamina = 100 end
                if SprintModule.MaxStamina then SprintModule.MaxStamina = 100 end
                if SprintModule.StaminaLoss then SprintModule.StaminaLoss = 0 end
                if SprintModule.DrainRate then SprintModule.DrainRate = 0 end
            end)
        end
        
        if ANTISTUN_ENABLED then
            if StatusModule then
                pcall(function()
                    if StatusModule.IsStunned ~= nil then StatusModule.IsStunned = false end
                    if StatusModule.Stunned ~= nil then StatusModule.Stunned = false end
                    if StatusModule.StunDuration then StatusModule.StunDuration = 0 end
                end)
            end
            
            local character = LocalPlayer.Character
            if character then
                pcall(function()
                    local humanoid = character:FindFirstChildOfClass("Humanoid")
                    if humanoid and humanoid.PlatformStand == true then
                        humanoid.PlatformStand = false
                    end
                    for _, object in pairs(character:GetChildren()) do
                        local name = object.Name:lower()
                        if name:find("stun") or name:find("daze") or name:find("paralyze") or name:find("blind") then
                            object:Destroy()
                        end
                    end
                    if character.GetAttributes then
                        for attrName, _ in pairs(character:GetAttributes()) do
                            local name = attrName:lower()
                            if name:find("stun") or name:find("isstunned") then
                                character:SetAttribute(attrName, false)
                            end
                        end
                    end
                end)
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    local Character = LocalPlayer.Character
    if Character then
        local Humanoid = Character:FindFirstChildOfClass("Humanoid")
        if Humanoid then
            if USEJUMP_ENABLED then
                Humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)

                if not Humanoid.UseJumpPower then
                    Humanoid.UseJumpPower = true
                end

                if Humanoid.JumpPower ~= 50 then
                    Humanoid.JumpPower = 50
                end
            else
                if Humanoid.JumpPower > 0 or Humanoid.JumpHeight > 0 then
                    ResetToGameDefault(Humanoid)
                end
            end
        end
    end
end)

