local dragging, dragInput, mousePos, framePos
local restoreDragging, restoreDragInput, restoreMousePos, restoreFramePos

local savedMainPosition = MainFrame.Position
local savedRestorePosition = RestoreBtn.Position

MainFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		mousePos = input.Position
		framePos = MainFrame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				savedMainPosition = MainFrame.Position
			end
		end)
	end
end)

MainFrame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		dragInput = input
	end
end)

UIS.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - mousePos

		MainFrame.Position = UDim2.new(
			framePos.X.Scale,
			framePos.X.Offset + delta.X,
			framePos.Y.Scale,
			framePos.Y.Offset + delta.Y
		)

		savedMainPosition = MainFrame.Position
	end
end)

RestoreBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		restoreDragging = true
		restoreMousePos = input.Position
		restoreFramePos = RestoreBtn.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				restoreDragging = false
				savedRestorePosition = RestoreBtn.Position
			end
		end)
	end
end)

RestoreBtn.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		restoreDragInput = input
	end
end)

UIS.InputChanged:Connect(function(input)
	if input == restoreDragInput and restoreDragging then
		local delta = input.Position - restoreMousePos

		RestoreBtn.Position = UDim2.new(
			restoreFramePos.X.Scale,
			restoreFramePos.X.Offset + delta.X,
			restoreFramePos.Y.Scale,
			restoreFramePos.Y.Offset + delta.Y
		)

		savedRestorePosition = RestoreBtn.Position
	end
end)

local function getPlayerTeamColor(player)
	if not player.Character then return nil end

	for _, v in pairs(SpectatingFolder:GetChildren()) do
		if v == player.Character then
			return SPECTATE_COLOR
		end
	end

	if LocalPlayer:IsFriendsWith(player.UserId) then
		return FRIEND_COLOR
	end

	for _, v in pairs(KillersFolder:GetChildren()) do
		if v == player.Character then
			return KILLER_COLOR
		end
	end

	for _, v in pairs(SurvivorsFolder:GetChildren()) do
		if v == player.Character then
			return SURVIVOR_COLOR
		end
	end

	return nil
end

local function applyPlayerESP()
	for _, player in pairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local color = getPlayerTeamColor(player)

			if color then
				local esp = player.Character:FindFirstChild("ESP_HIGHLIGHT")

				if not esp then
					esp = Instance.new("Highlight")
					esp.Name = "ESP_HIGHLIGHT"
					esp.Adornee = player.Character
					esp.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					esp.Parent = player.Character
				end

				esp.FillColor = color
			else
				local esp = player.Character:FindFirstChild("ESP_HIGHLIGHT")
				if esp then
					esp:Destroy()
				end
			end
		end
	end
end

local function startPlayerESP()
	if PLAYER_CONNECTION then return end

	PLAYER_CONNECTION = task.spawn(function()
		while PLAYER_ESP and not ScreenGui:GetAttribute("Destroyed") do
			applyPlayerESP()
			task.wait(0.25)
		end
		
		PLAYER_CONNECTION = nil
	end)
end

local function removePlayerESP()
	if PLAYER_CONNECTION then
		task.cancel(PLAYER_CONNECTION)
		PLAYER_CONNECTION = nil
	end

	for _, player in pairs(Players:GetPlayers()) do
		if player.Character then
			local esp = player.Character:FindFirstChild("ESP_HIGHLIGHT")
			if esp then
				esp:Destroy()
			end
		end
	end
end

local function enableFullbright()
	OLD_SETTINGS.Brightness = Lighting.Brightness
	OLD_SETTINGS.ClockTime = Lighting.ClockTime
	OLD_SETTINGS.FogEnd = Lighting.FogEnd
	OLD_SETTINGS.GlobalShadows = Lighting.GlobalShadows
	OLD_SETTINGS.Ambient = Lighting.Ambient

	Lighting.Brightness = 3
	Lighting.ClockTime = 12
	Lighting.FogEnd = 100000
	Lighting.GlobalShadows = false
	Lighting.Ambient = Color3.new(1,1,1)
end

local function disableFullbright()
	if next(OLD_SETTINGS) then
		Lighting.Brightness = OLD_SETTINGS.Brightness
		Lighting.ClockTime = OLD_SETTINGS.ClockTime
		Lighting.FogEnd = OLD_SETTINGS.FogEnd
		Lighting.GlobalShadows = OLD_SETTINGS.GlobalShadows
		Lighting.Ambient = OLD_SETTINGS.Ambient
	end
end

local function startSpeed()
	if SPEED_CONNECTION then return end

	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		NORMAL_WALK_SPEED = humanoid.WalkSpeed
	end

	SPEED_CONNECTION = RunService.RenderStepped:Connect(function(deltaTime)
		if not SPEED_ENABLED then return end

		local character = LocalPlayer.Character
		if not character then return end

		local rootPart = character:FindFirstChild("HumanoidRootPart")
		local humanoid = character:FindFirstChildOfClass("Humanoid")

		if rootPart and humanoid and humanoid.Health > 0 and humanoid.MoveDirection.Magnitude > 0 then
			local dragFactor = (SPEED_MULTIPLIER - 1) * NORMAL_WALK_SPEED * deltaTime
			local moveOffset = humanoid.MoveDirection * dragFactor

			rootPart.CFrame = rootPart.CFrame + moveOffset
		end
	end)
end

local function stopSpeed()
	SPEED_ENABLED = false

	if SPEED_CONNECTION then
		SPEED_CONNECTION:Disconnect()
		SPEED_CONNECTION = nil
	end

	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid and humanoid.Health > 0 then
		humanoid.WalkSpeed = NORMAL_WALK_SPEED
	end
end

local function updateGeneratorESP(gen)
	local highlight = gen:FindFirstChild("GEN_ESP")
	local progress = gen:FindFirstChild("Progress", true)

	if highlight and progress then
		if progress.Value >= 100 then
			highlight.FillColor = GEN_COLOR
		else
			highlight.FillColor = Color3.fromRGB(255,175,0)
		end
	end
end


local function doGenerator(gen)
	local main = gen:FindFirstChild("Main")
	if not main then return end

	local prompt = main:FindFirstChildOfClass("ProximityPrompt")
	if not prompt then return end

	local progress = gen:FindFirstChild("Progress", true)
	if progress and progress.Value >= 100 then
		updateGeneratorESP(gen)
		return
	end

	local remotes = gen:FindFirstChild("Remotes") or gen.Parent:FindFirstChild("Remotes")
	if not remotes then return end

	for _, re in pairs(remotes:GetChildren()) do
		if re:IsA("RemoteEvent") and re.Name == "RE" then
			pcall(function()
				re:FireServer(prompt)
			end)
		end
	end

	task.delay(0.5, function()
		updateGeneratorESP(gen)
	end)
end

local function startAutoGen()
	AUTO_GEN_THREAD = task.spawn(function()
		while AUTO_GEN and not ScreenGui:GetAttribute("Destroyed") do
			pcall(function()
				local mapFolder = workspace:FindFirstChild("Map")
				if mapFolder then
					local ingame = mapFolder:FindFirstChild("Ingame")
					if ingame and ingame:FindFirstChild("Map") then
						for _, gen in pairs(ingame.Map:GetChildren()) do
							if gen:IsA("Model") and (gen.Name == "Generator" or gen:FindFirstChild("Progress", true)) then
								doGenerator(gen)
								task.wait(0.1)
							end
						end
					end
				end
			end)
			task.wait(1)
		end

		AUTO_GEN_THREAD = nil
	end)
end

local function setupGenerator(gen)
	if not gen:IsA("Model") then return end
	if GEN_CACHE[gen] then return end

	local highlight = gen:FindFirstChild("GEN_ESP")
	if not highlight then
		highlight = Instance.new("Highlight")
		highlight.Name = "GEN_ESP"
		highlight.Adornee = gen
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = gen
	end

	GEN_CACHE[gen] = true

	local progress = gen:FindFirstChild("Progress", true)
	if progress then
		local function updateColor()
			if highlight and highlight.Parent then
				highlight.FillColor = (progress.Value >= 100)
					and GEN_COLOR
					or Color3.fromRGB(255,175,0)
			end
		end
		
		updateColor()

		if not progress:FindFirstChild("ESP_CONNECTION") then
			local tag = Instance.new("BoolValue")
			tag.Name = "ESP_CONNECTION"
			tag.Parent = progress

			progress:GetPropertyChangedSignal("Value"):Connect(updateColor)
		end
	end
end

local function applyGenESP()
	if GEN_CONNECTION then return end
	
	GEN_CONNECTION = task.spawn(function()
		while GEN_ESP and not ScreenGui:GetAttribute("Destroyed") do
			pcall(function()
				local mapFolder = workspace:FindFirstChild("Map")
				local ingame = mapFolder and mapFolder:FindFirstChild("Ingame")
				local currentMap = ingame and ingame:FindFirstChild("Map")
				
				if currentMap then
					for _, obj in pairs(currentMap:GetChildren()) do
						if obj:IsA("Model") and obj.Name == "Generator" then
							setupGenerator(obj) 
						end
					end
				end
			end)
			task.wait(1) 
		end

		GEN_CONNECTION = nil
	end)
end

local function removeGenESP()
	if GEN_CONNECTION then
		task.cancel(GEN_CONNECTION)
		GEN_CONNECTION = nil
	end

	for gen, _ in pairs(GEN_CACHE) do
		if gen and gen:FindFirstChild("GEN_ESP") then
			gen.GEN_ESP:Destroy()
		end
	end

	GEN_CACHE = {}
end

local function setupItemESP(tool)
	if not tool:IsA("Tool") then return end
	if tool:FindFirstChild("ITEM_ESP") then return end

	local h = Instance.new("Highlight")
	h.Name = "ITEM_ESP"
	h.Adornee = tool
	h.FillColor = ITEM_COLOR
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = tool
end

local function applyItemESP()
	for _, obj in pairs(Ingame:GetDescendants()) do
		if obj:IsA("Tool") then
			setupItemESP(obj)
		end
	end

	if not ITEM_CONNECTION then
		ITEM_CONNECTION = Ingame.DescendantAdded:Connect(function(obj)
			if ScreenGui:GetAttribute("Destroyed") then
				ITEM_CONNECTION:Disconnect()
				ITEM_CONNECTION = nil
				return
			end

			if ITEM_ESP and obj:IsA("Tool") then
				setupItemESP(obj)
			end
		end)
	end
end

local function removeItemESP()
	for _, obj in pairs(workspace:GetDescendants()) do
		local h = obj:FindFirstChild("ITEM_ESP")
		if h then h:Destroy() end
	end

	if ITEM_CONNECTION then
		ITEM_CONNECTION:Disconnect()
		ITEM_CONNECTION = nil
	end
end

