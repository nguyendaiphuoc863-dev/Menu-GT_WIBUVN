local function NextWord()
    local w = WordList[Index]
    Index = (Index % #WordList) + 1
    return w
end

task.spawn(function()
    while Gui.Parent and task.wait(0.25) do
        if AutoWrite then
            local boxes = {}
            local buttons = {}

            for _, obj in ipairs(PlayerGui:GetDescendants()) do
                if obj:IsA("TextBox") and obj.Visible then
                    table.insert(boxes, obj)
                elseif (obj:IsA("TextButton") or obj:IsA("ImageButton")) and obj.Visible then
                    local nameLower = obj.Name:lower()
                    local textLower = obj:IsA("TextButton") and obj.Text:lower() or ""
                    if nameLower:find("submit") or nameLower:find("send") or textLower:find("submit") or textLower:find("send") or textLower:find("write") then
                        table.insert(buttons, obj)
                    end
                end
            end

            if #boxes > 0 then
                local filled = false
                for _, box in ipairs(boxes) do
                    if box.Text == "" then
                        local word = NextWord()
                        Info.Text = "Written: " .. word
                        box:CaptureFocus()
                        task.wait(0.05)
                        box.Text = word
                        task.wait(0.05)
                        box:ReleaseFocus(true)
                        filled = true
                    end
                end

                if filled then
                    task.wait(0.1)
                    for _, btn in ipairs(buttons) do
                        if firesignal then
                            pcall(function() firesignal(btn.MouseButton1Click) end)
                            pcall(function() firesignal(btn.Activated) end)
                        end
                    end
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
                    task.wait(0.05)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)

                    task.wait(1.35)
                end
            end
        end
    end
end)
